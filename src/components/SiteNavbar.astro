---
import UIIcon from './UIIcon.astro';
import { localePath, type Locale } from '../lib/i18n';
import { navigationCopy } from '../lib/navigation';
import { diagnosticCopy } from '../lib/diagnostic-cta';
import PlatformGroups from './navigation/PlatformGroups.astro';
import LanguageLinks from './navigation/LanguageLinks.astro';

interface Props { locale: Locale; minimal?: boolean; }
const { locale, minimal = false } = Astro.props;
const copy = navigationCopy[locale];
const languageLabel = locale === 'pt-BR' ? 'PT' : locale === 'en-US' ? 'EN' : 'ES';
const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/$/, '') || '/';
const diagnosisHref = diagnosticCopy(locale).contactHref;
---

<site-navigation class="site-navigation" data-minimal={minimal ? 'true' : undefined}>
  <nav id="site-navbar" class="nav-shell" aria-label={copy.label}>
    {minimal ? (
      <span class="nav-brand"><img src="/yapt-logo.svg" alt="yapt." width="112" height="40" /></span>
    ) : (
      <a class="nav-brand" href={localePath('/', locale)} aria-label={copy.home}>
        <img src="/yapt-logo.svg" alt="yapt." width="112" height="40" fetchpriority="high" />
      </a>
    )}

    {!minimal && <div class="nav-desktop nav-main-links">
      {copy.primary.map(link => <a class="nav-link" href={localePath(link.href, locale)} aria-current={currentPath === localePath(link.href, locale) ? 'page' : undefined}>{link.label}</a>)}
      <details class="nav-disclosure" data-desktop-disclosure>
        <summary class="nav-link" aria-controls="platform-menu">
          {copy.platform}<span class="nav-chevron" aria-hidden="true"></span>
        </summary>
        <div class="nav-popover platform-popover" id="platform-menu">
          <PlatformGroups locale={locale} />
        </div>
      </details>
      <a class="nav-link" href={localePath('/blog', locale)}>{copy.insights}</a>
    </div>}

    <div class="nav-actions">
      {!minimal && <>
        <a class="nav-link nav-desktop" href="https://app.yapt.ai/auth">{copy.login}</a>
        <details class="nav-disclosure nav-desktop" data-desktop-disclosure>
          <summary class="nav-link nav-language-toggle" aria-label={copy.language} aria-controls="language-menu">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18Z" />
            </svg>
            {languageLabel}<span class="nav-chevron" aria-hidden="true"></span>
          </summary>
          <div class="nav-popover language-popover" id="language-menu">
            <LanguageLinks locale={locale} pathname={pathname} />
          </div>
        </details>
      </>}
      {minimal ? (
        <a class="nav-diagnosis" href={diagnosticCopy(locale).contactHref} data-diagnostic-trigger data-diagnostic-placement="menu" target="_blank" rel="noopener noreferrer">{copy.diagnosis}</a>
      ) : (
        <a class="nav-diagnosis" href={diagnosisHref} data-diagnostic-trigger data-diagnostic-placement="menu" target="_blank" rel="noopener noreferrer">{copy.diagnosis}<span aria-hidden="true"><UIIcon name="arrow-up-right" size={18} /></span></a>
      )}
    </div>

    {!minimal && <details class="nav-mobile-disclosure" data-mobile-disclosure>
      <summary class="nav-mobile-toggle" aria-label={copy.menu} aria-controls="mobile-menu">
        <span class="nav-menu-line"></span><span class="nav-menu-line"></span>
      </summary>
      <div class="nav-mobile-panel" id="mobile-menu" aria-label={copy.menu} role="region">
        <div class="mobile-primary-links">
          {copy.primary.map(link => <a class="nav-link" href={localePath(link.href, locale)} aria-current={currentPath === localePath(link.href, locale) ? 'page' : undefined}>{link.label}<span aria-hidden="true"><UIIcon name="arrow-up-right" size={18} /></span></a>)}
        </div>
        <p class="mobile-platform-label">{copy.platform}</p>
        <PlatformGroups locale={locale} compact />
        <div class="mobile-secondary-links">
          <a class="nav-link" href={localePath('/blog', locale)}>{copy.insights}</a>
          <a class="nav-link" href="https://app.yapt.ai/auth">{copy.login}<span aria-hidden="true"><UIIcon name="arrow-up-right" size={18} /></span></a>
        </div>
        <div class="mobile-language-row">
          <span class="nav-group-label">{copy.language}</span>
          <LanguageLinks locale={locale} pathname={pathname} compact />
        </div>
        <a class="nav-diagnosis mobile-diagnosis" href={diagnosisHref} data-diagnostic-trigger data-diagnostic-placement="menu" target="_blank" rel="noopener noreferrer">{copy.diagnosis}<span aria-hidden="true"><UIIcon name="arrow-up-right" size={18} /></span></a>
      </div>
    </details>}
  </nav>
</site-navigation>

<script>
  import './navigation/controller';
</script>

<style is:global>
  .site-navigation { --nav-ink:#243c35; --nav-muted:#66766f; --nav-teal:#20b2aa; position:fixed; z-index:60; top:14px; left:16px; right:16px; display:block; font-family:Poppins, sans-serif; color:var(--nav-ink); }
  .site-navigation * { box-sizing:border-box; }
  .site-navigation .nav-shell { position:relative; display:flex; align-items:center; gap:10px; max-width:1280px; min-height:68px; margin:auto; padding:8px 12px; border:1px solid rgba(255,255,255,.9); border-radius:22px; background:rgba(255,255,255,.94); box-shadow:0 8px 36px #112f2410, inset 0 1px 0 #fff; backdrop-filter:blur(24px) saturate(145%); -webkit-backdrop-filter:blur(24px) saturate(145%); }
  .site-navigation .nav-brand { display:flex; align-items:center; flex-shrink:0; min-height:44px; margin-right:auto; border-radius:10px; }
  .site-navigation .nav-brand img { display:block; width:100px; height:auto; }
  .site-navigation .nav-link, .site-navigation summary, .site-navigation button { -webkit-tap-highlight-color:transparent; }
  .site-navigation .nav-link { display:flex; align-items:center; justify-content:center; gap:7px; min-height:44px; padding:0 10px; border-radius:11px; color:var(--nav-ink); text-decoration:none; font-size:12px; font-weight:500; white-space:nowrap; transition:background .18s, color .18s; }
  .site-navigation .nav-link:hover, .site-navigation .nav-link[aria-current=page], .site-navigation .nav-disclosure[open] > summary { background:#eaf4ef; color:#12695e; }
  .site-navigation a:focus-visible, .site-navigation summary:focus-visible, .site-navigation button:focus-visible { outline:3px solid #0d9488; outline-offset:3px; }
  .site-navigation .nav-actions { display:flex; align-items:center; gap:2px; margin-left:auto; }
  .site-navigation .nav-diagnosis { display:flex; align-items:center; justify-content:center; gap:10px; min-height:44px; padding:0 15px; border:1px solid transparent; border-radius:12px; background:var(--nav-teal); color:#063c39; text-decoration:none; font:600 12px Poppins,sans-serif; white-space:nowrap; cursor:pointer; transition:background .18s, box-shadow .18s; }
  .site-navigation .nav-diagnosis:hover { background:#2dd4bf; box-shadow:0 3px 12px #20b2aa20; }
  .site-navigation .nav-diagnosis > span { font-size:17px; font-weight:400; }
  .site-navigation .nav-desktop { display:none; }
  .site-navigation summary { list-style:none; cursor:pointer; user-select:none; }
  .site-navigation summary::-webkit-details-marker { display:none; }
  .site-navigation .nav-disclosure { position:relative; }
  .site-navigation .nav-chevron { width:6px; height:6px; margin:-3px 2px 0 1px; border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor; transform:rotate(45deg); transition:transform .18s; }
  .site-navigation details[open] > summary .nav-chevron { margin-top:3px; transform:rotate(225deg); }
  .site-navigation .nav-popover { position:absolute; top:calc(100% + 16px); padding:14px; border:1px solid #e3ece6; border-radius:20px; background:rgba(255,255,255,.98); box-shadow:0 18px 48px #102b2321; }
  .site-navigation .platform-popover { width:530px; left:50%; transform:translateX(-50%); }
  .site-navigation .platform-groups { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .site-navigation .nav-group-label { margin:0 0 6px; padding:4px 12px; color:var(--nav-muted); font-size:10px; font-weight:600; letter-spacing:.09em; text-transform:uppercase; }
  .site-navigation .platform-link { display:flex; flex-direction:column; justify-content:center; gap:5px; min-height:72px; padding:12px; color:var(--nav-ink); text-decoration:none; border-radius:12px; }
  .site-navigation .platform-link > span { font-size:13px; font-weight:600; }
  .site-navigation .platform-link small { color:var(--nav-muted); font-family:Inter,sans-serif; font-size:11px; line-height:1.5; }
  .site-navigation .platform-link:hover { background:#eff7f3; }
  .site-navigation .nav-language-toggle { padding:0 9px; gap:5px; }
  .site-navigation .language-popover { width:185px; right:0; padding:6px; }
  .site-navigation .nav-language-links a { display:flex; align-items:center; gap:10px; min-height:44px; padding:0 12px; border-radius:10px; color:var(--nav-ink); font-size:11px; font-weight:500; text-decoration:none; }
  .site-navigation .nav-language-links a:hover, .site-navigation .nav-language-links a[aria-current] { background:#eaf4ef; color:#12695e; }
  .site-navigation .nav-language-name { color:var(--nav-muted); }
  .site-navigation .nav-language-check { margin-left:auto; }
  .site-navigation .nav-mobile-disclosure { flex-shrink:0; }
  .site-navigation .nav-mobile-toggle { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; width:44px; height:44px; border:1px solid #dce8e1; border-radius:12px; background:#ffffff80; }
  .site-navigation .nav-menu-line { display:block; width:17px; height:1.5px; background:var(--nav-ink); transition:transform .18s; }
  .site-navigation .nav-mobile-disclosure[open] .nav-menu-line:first-child { transform:translateY(3.25px) rotate(45deg); }
  .site-navigation .nav-mobile-disclosure[open] .nav-menu-line:last-child { transform:translateY(-3.25px) rotate(-45deg); }
  .site-navigation .nav-mobile-panel { position:absolute; top:calc(100% + 10px); left:0; right:0; max-height:calc(100vh - 112px); max-height:calc(100dvh - 112px); padding:18px; overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; border:1px solid #e1ebe4; border-radius:22px; background:#fbfdfb; box-shadow:0 20px 50px #102b2326; }
  .site-navigation .mobile-primary-links { display:grid; gap:2px; padding-bottom:15px; border-bottom:1px solid #e1ebe4; }
  .site-navigation .mobile-primary-links .nav-link { justify-content:space-between; min-height:49px; padding:0 10px; font-size:17px; font-weight:500; }
  .site-navigation .mobile-primary-links .nav-link > span, .site-navigation .mobile-secondary-links .nav-link > span { color:#769086; font-size:18px; }
  .site-navigation .mobile-platform-label { margin:20px 10px 13px; font-size:13px; font-weight:600; }
  .site-navigation .platform-groups-compact { gap:8px; }
  .site-navigation .platform-groups-compact .nav-group-label { padding:0 10px; font-size:9px; letter-spacing:.06em; }
  .site-navigation .platform-groups-compact .platform-link { min-height:44px; padding:8px 10px; }
  .site-navigation .platform-groups-compact .platform-link > span { font-size:12px; font-weight:500; }
  .site-navigation .mobile-secondary-links { display:grid; grid-template-columns:1fr 1fr; gap:8px; padding:12px 0; margin-top:14px; border-top:1px solid #e1ebe4; border-bottom:1px solid #e1ebe4; }
  .site-navigation .mobile-secondary-links .nav-link { justify-content:space-between; padding:0 10px; }
  .site-navigation .mobile-language-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 0; }
  .site-navigation .mobile-language-row .nav-group-label { margin:0; padding:0 10px; }
  .site-navigation .nav-language-compact { display:flex; gap:3px; }
  .site-navigation .nav-language-compact a { min-width:44px; justify-content:center; padding:0 8px; border:1px solid #e4ece6; }
  .site-navigation .nav-language-compact .nav-language-check { display:none; }
  .site-navigation .mobile-diagnosis { min-height:48px; }
  .site-navigation .nav-minimal-status { position:absolute; top:calc(100% + 10px); right:0; max-width:320px; margin:0; padding:16px; border:1px solid #e1ebe4; border-radius:16px; background:#fff; box-shadow:0 8px 30px #102b2326; font-size:12px; line-height:1.6; }
  .site-navigation [hidden] { display:none; }
  @media (max-width:380px) {
    .site-navigation { left:10px; right:10px; }
    .site-navigation .nav-shell { gap:6px; padding:8px; }
    .site-navigation .nav-brand img { width:92px; }
    .site-navigation .nav-diagnosis { gap:6px; padding:0 10px; font-size:11px; }
    .site-navigation .nav-mobile-panel { padding:14px; }
  }
  @media (min-width:1120px) {
    .site-navigation .nav-shell { gap:16px; padding:8px 18px; }
    .site-navigation .nav-brand img { width:112px; }
    .site-navigation .nav-desktop { display:flex; }
    .site-navigation .nav-main-links { align-items:center; gap:0; }
    .site-navigation .nav-mobile-disclosure { display:none; }
    .site-navigation .nav-actions { gap:4px; }
    .site-navigation .nav-diagnosis { margin-left:5px; padding:0 17px; }
  }
  @media (min-width:1250px) { .site-navigation .nav-main-links { gap:4px; } .site-navigation .nav-link { font-size:13px; } }
  @media (prefers-reduced-motion:reduce) { .site-navigation *, .site-navigation *::before, .site-navigation *::after { transition:none; } }
</style>
