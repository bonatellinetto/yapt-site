---
import OperationsRoutineScreens from '../operations/OperationsRoutineScreens.astro';
import type { AutomationScreen } from '../../lib/automation-motions';
interface Props { screen: AutomationScreen }
const {screen}=Astro.props;
const isRule=['marketing-rule','sales-followup','service-rule'].includes(screen);
const service=screen==='service-rule';
const sales=screen==='sales-followup';
const ruleTitle=service?'Acompanhamento do serviço • Demonstração':sales?'Proposta sem resposta • Demonstração':'Boas-vindas e acompanhamento • Demonstração';
import './automation-reproductions.css';
---
<div class="am-reproduction" data-automation-reproduction={screen} aria-hidden="true">
  {screen==='flow-chat' ? <div class="am-assistant-screen">
    <header class="am-app-header"><img src="/produto/app-icon.svg" width="30" height="30" alt=""/><b>iavéh</b><span class="am-muted">Construir</span><span class="am-top-end">Nova conversa　⋯</span></header>
    <div class="am-assistant-layout"><div class="am-assistant-backdrop"><p>yaFlows</p><h3>Automações</h3><div class="am-placeholder"></div><div class="am-placeholder"></div><div class="am-placeholder"></div></div><div class="am-assistant-chat">
      <p class="am-chat-intro">O que vamos construir?</p>
      <div class="am-user-bubble">Crie o fluxo Vitrine — Atendimento conectado. Disparo manual. Pergunte nome e escolha: produto ou suporte. Consulte o produto ou confirme o suporte e conclua. Deixe desligado, sem canais.</div>
      <div class="am-ai-bubble">Montei uma proposta para você conferir. Nada é ativado sem a sua revisão.</div>
      <article class="am-proposal"><p class="am-overline">Proposta de fluxo</p><h3>Vitrine — Atendimento conectado</h3><p>Perguntar nome e escolha, consultar o produto ou confirmar o suporte e concluir.</p><dl><div><dt>Gatilho</dt><dd>Disparo manual</dd></div><div><dt>Canais</dt><dd>Nenhum canal vinculado</dd></div><div><dt>Caixas</dt><dd>Início → Nome e escolha → Produto ou suporte → Concluir</dd></div></dl><span class="am-primary">Aplicar</span><small>O fluxo é criado desligado.</small></article>
      <div class="am-chat-input">Descreva o que precisa…<span>↑</span></div>
    </div></div>
  </div> : screen==='flow-builder' ? <div class="am-builder-screen">
    <header class="am-app-header"><b>Vitrine — Atendimento conectado</b><span class="am-neutral">Desligado</span><span class="am-top-end">Problemas　 Testar　 Histórico de execuções　 <span class="am-primary">Salvar</span></span></header>
    <div class="am-builder-tabs"><span class="am-selected">Quadro</span><span>Roteiro</span><span class="am-muted">Auto-organizar</span></div>
    <aside class="am-palette"><p>CAIXAS DO FLUXO</p>{['Início','Enviar mensagem','Condição','Inteligência artificial','Requisição HTTP','Atualizar campo','Transferir atendimento','Concluir'].map((name,i)=><div><span>{['◉','▱','⑂','✦','↗','✎','⇄','✓'][i]}</span>{name}</div>)}</aside>
    <div class="am-flow-canvas"><svg class="am-wires" viewBox="0 0 890 590"><path d="M148 153H220Q252 153 252 198V263H300M478 263H510Q550 263 550 213V153H605M478 263H510Q550 263 550 398H605"/></svg>
      <article class="am-node am-node-start"><span class="am-node-icon">◉</span><div><small>Início</small><strong>Disparo manual</strong></div><i></i></article>
      <article class="am-node am-node-ai"><span class="am-node-icon am-purple">▱</span><div><small>Enviar mensagem</small><strong>Nome e escolha</strong><p>Produto ou suporte?</p></div><i></i></article>
      <article class="am-node am-node-http"><span class="am-node-icon am-blue">↗</span><div><small>Requisição HTTP</small><strong>Consultar produto</strong><p>Salvar retorno: produto</p></div><i></i></article>
      <article class="am-node am-node-transfer"><span class="am-node-icon am-amber">✓</span><div><small>Enviar mensagem</small><strong>Confirmar suporte</strong><p>Confirmar e concluir</p></div><i></i></article>
      <span class="am-canvas-controls">−　100%　＋　⊞</span>
    </div>
  </div> : screen==='flow-condition' ? <div class="am-config-screen"><header class="am-app-header"><b>Condição</b><span class="am-top-end">Conferir caminhos　×</span></header><div class="am-config-card"><span class="am-config-icon">⑂</span><h3>Quando seguir por este caminho?</h3><label>Campo</label><div class="am-input">Escolha do cliente <span>⌄</span></div><div class="am-two-columns"><div><label>Condição</label><div class="am-input">É igual a <span>⌄</span></div></div><div><label>Valor</label><div class="am-input">Consultar produto</div></div></div><div class="am-branch-row"><span class="am-positive">Se atender</span><strong>Consultar produto</strong><b>→</b></div><div class="am-branch-row"><span class="am-neutral">Caso contrário</span><strong>Confirmar suporte</strong><b>→</b></div><p class="am-config-note">Cada caminho segue a condição definida para o processo.</p></div></div>
  : isRule ? <div class="am-rule-screen"><header class="am-app-header"><b>{ruleTitle}</b><span class="am-neutral">{service?'Prévia • Em breve':'Rascunho'}</span><span class="am-top-end">← Voltar　 <span class="am-primary">Salvar</span></span></header><div class="am-rule-content"><h3>Réguas inteligentes</h3><p class="am-muted">Uma sequência de ações, do gatilho ao próximo passo.</p><section class="am-rule-section"><p>Quando</p><div class="am-rule-trigger"><span class="am-node-icon">◉</span><div><strong>{service?'Caso entrar na etapa':sales?'Negócio parado na etapa':'Contato criado'}</strong><small>{service?'Em andamento':sales?'Proposta • 3 dias sem avanço':'Todas as origens'}</small></div><span>Alterar</span></div></section><section class="am-rule-section"><p>Fazer</p><div class="am-rule-action"><b>1.</b><span>◷</span><strong>Esperar</strong><em>{service?'Prazo definido no serviço':sales?'1 dia':'24 horas'}</em></div><div class="am-rule-action"><b>2.</b><span>{sales||service?'▤':'▱'}</span><strong>{sales||service?'Criar atividade':'Enviar mensagem'}</strong><em>{service?'Conferir andamento do caso':sales?'Retomar a proposta':'Continuar a comunicação'}</em></div><div class="am-rule-action"><b>3.</b><span>⑂</span><strong>{service?'Verificar etapa do caso':'Se respondeu'}</strong><em>{service?'Seguir ou encerrar a sequência':'Continuar pelo caminho configurado'}</em></div></section><div class="am-rule-footer"><span>Permitir reentrada</span><span class="am-toggle"></span><span>Parar quando responder</span><span class="am-toggle am-toggle-on"></span></div></div></div>
  : screen==='activity' ? <OperationsRoutineScreens kind="activity"/>
  : screen==='field' ? <OperationsRoutineScreens kind="field"/>
  : screen==='flow-http' ? <div class="am-config-screen"><header class="am-app-header"><b>Requisição HTTP</b><span class="am-top-end">Consultar produto　×</span></header><div class="am-config-card am-http-card"><h3>Conecte esta etapa ao sistema</h3><div class="am-two-columns am-http-top"><div><label>Método</label><div class="am-input">GET <span>⌄</span></div></div><div><label>URL</label><div class="am-input">https://dummyjson.com/products/1</div></div></div><div class="am-two-columns"><div><label>Salvar retorno como</label><div class="am-input">produto</div></div><div><label>Tempo limite</label><div class="am-input">30 segundos</div></div></div><label>Dados da resposta</label><div class="am-response"><div><span>title</span><b>Essence Mascara Lash Princess</b></div><div><span>stock</span><b>99</b></div><div><span>id</span><b>1</b></div></div><p class="am-config-note">Exemplo de retorno: usar nome e estoque do produto na mensagem e concluir.</p><span class="am-primary">Testar chamada</span></div></div>
  : screen==='execution' ? <div class="am-execution-screen"><header class="am-app-header"><b>Histórico de execuções</b><span class="am-top-end">Vitrine — Atendimento conectado　⋯</span></header><div class="am-execution-content"><div class="am-execution-summary"><span class="am-overline">ROTEIRO ILUSTRATIVO · PRODUTO</span><h3>Exemplo de execução</h3><div><span>Flow</span><strong>Vitrine — Atendimento conectado</strong></div><div><span>Status</span><strong class="am-positive">Concluído · exemplo</strong></div></div><div class="am-execution-steps">{['Disparo manual','Nome e escolha','Consultar produto','Informar e concluir'].map((name,i)=><div><span class="am-run-tick">✓</span><div><small>Etapa {i+1}</small><strong>{name}</strong><p>{['Início manual previsto neste exemplo.','Perguntar nome e escolha entre produto e suporte.','GET /products/1 · retorno salvo como produto.','Informar nome e estoque do produto e encerrar.'][i]}</p></div><span class="am-positive">Concluído</span></div>)}</div></div></div>
  : <div class="am-config-screen"><header class="am-app-header"><b>Automações da operação</b></header><div class="am-config-card"><h3>Um próximo passo configurado.</h3><p>Defina o acontecimento, as condições e as ações da sequência.</p></div></div>}
</div>
