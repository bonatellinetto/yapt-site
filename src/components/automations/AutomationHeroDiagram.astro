---
import UIIcon from '../UIIcon.astro';
import NatureGlyph from '../home/NatureGlyph.astro';
import type {Locale} from '../../lib/i18n';
interface Props{locale:Locale}
const {locale}=Astro.props;
const c={
 'pt-BR':{input:'Acontecimento',inputDetail:'Conversa, evento ou etapa',core:'yaFlows',coreDetail:'Condições · IA · ações',output:'Próximo passo',outputDetail:'Atender, atualizar ou encaminhar',rules:'Réguas inteligentes',rulesDetail:'Continuidade na jornada',connections:'Conexões',connectionsDetail:'Sistemas e dados',label:'Visão ilustrativa de uma automação: um acontecimento entra no yaFlows, que conecta condições, IA, réguas e sistemas ao próximo passo.'},
 'en-US':{input:'Trigger',inputDetail:'Conversation, event or stage',core:'yaFlows',coreDetail:'Conditions · AI · actions',output:'Next step',outputDetail:'Serve, update or route',rules:'Intelligent rules',rulesDetail:'Continuity in the journey',connections:'Connections',connectionsDetail:'Systems and data',label:'Illustrative view of an automation: a trigger enters yaFlows, which connects conditions, AI, rules and systems to the next step.'},
 'es-ES':{input:'Evento',inputDetail:'Conversación, evento o etapa',core:'yaFlows',coreDetail:'Condiciones · IA · acciones',output:'Siguiente paso',outputDetail:'Atender, actualizar o derivar',rules:'Reglas inteligentes',rulesDetail:'Continuidad del recorrido',connections:'Conexiones',connectionsDetail:'Sistemas y datos',label:'Vista ilustrativa de una automatización: un evento entra en yaFlows y conecta condiciones, IA, reglas y sistemas con el siguiente paso.'},
}[locale];
---
<div class="am-hero-visual" role="img" aria-label={c.label}>
 <svg class="am-hero-lines" viewBox="0 0 600 320" preserveAspectRatio="none" aria-hidden="true"><path class="am-hero-path" d="M142 153H217M382 153H458M300 186V223Q300 242 280 242H238M300 223Q300 242 320 242H398"/><circle cx="300" cy="153" r="55"/><path class="am-hero-travel" d="M142 153H217M382 153H458M300 186V223Q300 242 280 242H238M300 223Q300 242 320 242H398"/></svg>
 <div class="am-hero-step am-hero-input"><span class="am-hero-icon"><UIIcon name="arrow-right" size={18} /></span><strong>{c.input}</strong><small>{c.inputDetail}</small></div>
 <div class="am-hero-step am-hero-core"><NatureGlyph name="automation" size={46}/><strong>{c.core}</strong><small>{c.coreDetail}</small><span class="am-hero-core-points" aria-hidden="true"><i></i><i></i><i></i></span></div>
 <div class="am-hero-step am-hero-output"><span class="am-hero-icon"><UIIcon name="check" size={18} /></span><strong>{c.output}</strong><small>{c.outputDetail}</small></div>
 <div class="am-hero-step am-hero-rules"><NatureGlyph name="automation" size={24}/><div><strong>{c.rules}</strong><small>{c.rulesDetail}</small></div></div>
 <div class="am-hero-step am-hero-connections"><NatureGlyph name="integrations" size={24}/><div><strong>{c.connections}</strong><small>{c.connectionsDetail}</small></div></div>
</div>
<style>
.am-hero-visual{position:relative;height:310px;width:100%;overflow:hidden;background:radial-gradient(ellipse at 50% 43%,#eff5df 0,transparent 62%),linear-gradient(145deg,#fbfdf9,#f8fbf5);font-family:Inter,sans-serif;color:#44633c}.am-hero-lines{position:absolute;inset:0;width:100%;height:100%;fill:none}.am-hero-lines circle{stroke:#dce8ca;stroke-width:1;stroke-dasharray:3 5;opacity:.7}.am-hero-path{stroke:#d4e1c8;stroke-width:1.5}.am-hero-travel{stroke:#8eb474;stroke-width:1.8;stroke-dasharray:8 18;animation:am-travel 5s linear infinite}.am-hero-step{position:absolute;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:14px 9px;background:#ffffffec;border:1px solid #e0e9d5;border-radius:15px;box-shadow:0 12px 22px -19px #31512650;min-width:0;box-sizing:border-box}.am-hero-step strong{display:block;font-size:clamp(9px,1vw,12px);font-weight:600;line-height:1.4;margin-top:7px}.am-hero-step small{display:block;font-size:clamp(8px,.75vw,10px);color:#8b9d7f;line-height:1.5;margin-top:5px;max-width:16ch}.am-hero-icon{display:grid;place-items:center;width:29px;height:29px;border-radius:9px;color:#739c58;background:#f1f7e9;font-size:18px}.am-hero-input{left:2%;top:31%;width:24%;min-height:106px}.am-hero-output{right:2%;top:31%;width:24%;min-height:106px}.am-hero-core{left:36%;top:21%;width:28%;min-height:148px;background:#fff;border-color:#c9dcb6;box-shadow:0 16px 28px -17px #52753350}.am-hero-core strong{font-family:Poppins,sans-serif;font-size:21px;color:#416b33;letter-spacing:-.035em;margin-top:5px}.am-hero-core small{max-width:20ch;font-size:9px}.am-hero-core-points{display:flex;gap:4px;margin-top:12px}.am-hero-core-points i{width:4px;height:4px;border-radius:50%;background:#acc891}.am-hero-rules,.am-hero-connections{top:77%;width:31%;padding:11px 10px;flex-direction:row;text-align:left;gap:9px;align-items:center;min-height:60px}.am-hero-rules{left:17%}.am-hero-connections{right:17%}.am-hero-rules strong,.am-hero-connections strong{font-size:10px;margin:0}.am-hero-rules small,.am-hero-connections small{font-size:8px;max-width:none;margin-top:3px;line-height:1.5}.am-hero-rules img,.am-hero-connections img{flex-shrink:0}
@keyframes am-travel{to{stroke-dashoffset:-104}}
@media(max-width:600px){.am-hero-visual{height:275px}.am-hero-step{padding:11px 5px;border-radius:12px}.am-hero-input,.am-hero-output{top:32%;min-height:102px}.am-hero-core{top:22%;min-height:135px}.am-hero-core strong{font-size:18px}.am-hero-core small{font-size:8px}.am-hero-rules,.am-hero-connections{top:77%;width:36%;min-height:54px;gap:5px;padding:8px 6px}.am-hero-rules{left:12%}.am-hero-connections{right:12%}.am-hero-rules strong,.am-hero-connections strong{font-size:8px}.am-hero-rules small,.am-hero-connections small{font-size:7px}.am-hero-rules img,.am-hero-connections img{width:20px;height:20px}.am-hero-step>small{max-width:14ch}}
@media(prefers-reduced-motion:reduce){.am-hero-travel{animation:none}}
</style>
