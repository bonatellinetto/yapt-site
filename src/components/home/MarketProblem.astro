---
import { homeCopy } from './content';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy(locale).problem;
---
<section class="home-section market-problem" id="gargalos" aria-labelledby="problem-heading">
  <div class="home-shell">
    <div class="home-section-head home-reveal">
      <div><p class="home-label">{c.eyebrow}</p><h2 class="home-heading" id="problem-heading">{c.title}</h2></div>
      <p class="home-intro">{c.description}</p>
    </div>
    <div class="problem-grid">
      {c.items.map((item, index) => (
        <article class="problem-item home-reveal">
          <div class="problem-top"><h3>{item.headline}</h3><span class="problem-index" aria-hidden="true">0{index + 1}</span></div>
          <div class="problem-metrics">
            {[
              { ...item.inside, label: c.insideLabel },
              { ...item.outside, label: c.outsideLabel },
            ].map(metric => (
              <div class="problem-metric">
                <p class="metric-label">{metric.label}</p>
                <p class="problem-number">{metric.number}</p>
                <p class="problem-fact">{metric.fact}</p>
                <small class="problem-source">{metric.source}</small>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
    <p class="problem-note">{c.note}</p>
    <div class="problem-bridge home-reveal">
      <div>
        <p class="bridge-lead">{c.bridgeLead}</p>
        <p class="bridge-title">{c.bridgeTitle}</p>
        <p class="bridge-text">{c.bridgeText}</p>
      </div>
      <a class="home-button" href="#diagnostico">{c.cta}</a>
    </div>
  </div>
</section>
<style>
  .market-problem { background: #f5f7f3; border-block: 1px solid #e6ece4; }
  .market-problem .home-section-head { display: block; text-align: left; }
  .market-problem .home-heading { max-width: none; font-size: clamp(32px, 3.1vw, 44px); text-wrap: balance; }
  .market-problem .home-section-head .home-intro { max-width: none; font-size: 16px; margin: 24px 0 0; }
  .problem-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .problem-item { display: flex; flex-direction: column; min-width: 0; overflow: hidden; background: #fff; border: 1px solid #dce5da; border-radius: 20px; box-shadow: 0 10px 28px -23px #244c2f30; }
  .problem-top { display: flex; flex-shrink: 0; justify-content: space-between; align-items: flex-start; gap: 17px; min-height: 113px; padding: 24px; background: #faf1d9; border-bottom: 1px solid #ece2c8; color: #43533a; }
  .problem-item:nth-child(2) .problem-top { background: #e3f0eb; border-bottom-color: #d3e4dc; color: #275548; }
  .problem-item:nth-child(3) .problem-top { background: #e9eff5; border-bottom-color: #d9e2eb; color: #375567; }
  .problem-top h3 { font: 600 14px/1.55 Poppins, sans-serif; letter-spacing: -.02em; margin: 0; text-wrap: pretty; }
  .problem-index { flex-shrink: 0; font: 500 10px/1.6 Inter, sans-serif; color: #657d6b; letter-spacing: .05em; padding-top: 2px; }
  .problem-metrics { display: grid; grid-template-rows: repeat(2, 1fr); flex: 1; padding: 24px; }
  .problem-metric { display: flex; flex-direction: column; min-height: 208px; }
  .problem-metric + .problem-metric { margin-top: 27px; padding-top: 26px; border-top: 1px solid #e3ebe5; }
  .metric-label { align-self: flex-start; color: #4d6d5b; background: #f0f5ee; border-radius: 6px; padding: 5px 8px; font: 500 9px/1.5 Inter, sans-serif; letter-spacing: .025em; margin: 0; }
  .problem-metric + .problem-metric .metric-label { background: #eaf3f0; color: #41675c; }
  .problem-number { font: 500 clamp(50px, 4.6vw, 66px)/1.12 Poppins, sans-serif; letter-spacing: -.065em; color: #164b3b; margin: 13px 0 12px; }
  .problem-fact { font: 400 14px/1.7 Inter, sans-serif; color: #375747; margin: 0; max-width: 35ch; text-wrap: pretty; }
  .problem-source { display: block; color: #738276; font: 400 8px/1.65 Inter, sans-serif; margin-top: auto; padding-top: 16px; }
  .problem-note { font-size: 8px; color: #738276; line-height: 1.7; margin: 15px 0 0; max-width: 130ch; }
  .problem-bridge { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 36px; padding: 33px 35px; margin-top: 39px; background: #fff; border: 1px solid #dce7d9; border-radius: 19px; }
  .bridge-lead { font-size: 13px; line-height: 1.8; color: #607766; max-width: 76ch; margin: 0; }
  .bridge-title { font: 500 21px/1.45 Poppins, sans-serif; letter-spacing: -.035em; color: #194936; margin: 13px 0 9px; text-wrap: pretty; }
  .bridge-text { font-size: 13px; line-height: 1.8; color: #607766; margin: 0; max-width: 73ch; }
  .problem-bridge .home-button { max-width: 255px; font-size: 12px; gap: 18px; text-align: left; }
  @media (max-width: 1023px) {
    .problem-grid { gap: 14px; }
    .problem-top, .problem-metrics { padding: 20px; }
    .problem-top { min-height: 125px; gap: 11px; }
    .problem-top h3 { font-size: 13px; }
    .problem-metric { min-height: 236px; }
    .problem-bridge { grid-template-columns: 1fr; gap: 24px; }
    .problem-bridge .home-button { max-width: none; width: fit-content; }
  }
  @media (max-width: 700px) {
    .problem-grid { grid-template-columns: 1fr; gap: 22px; }
    .problem-item { border-radius: 17px; }
    .problem-top { min-height: 0; padding: 19px 18px; gap: 18px; }
    .problem-top h3 { font-size: 14px; }
    .problem-metrics { grid-template-columns: minmax(0,1fr) minmax(0,1fr); grid-template-rows: auto; flex: none; padding: 22px 17px 24px; }
    .problem-metric { min-height: 0; min-width: 0; padding-right: 13px; }
    .problem-metric + .problem-metric { margin: 0; padding: 0 0 0 13px; border-top: 0; border-left: 1px solid #e3ebe5; }
    .metric-label { align-self: stretch; display: flex; align-items: center; min-height: 37px; font-size: 9px; line-height: 1.5; padding: 5px 7px; }
    .problem-number { font-size: 46px; margin: 13px 0 11px; }
    .problem-fact { font-size: 12px; line-height: 1.75; max-width: 30ch; }
    .problem-source { font-size: 8px; padding-top: 14px; }
    .problem-bridge { margin-top: 29px; padding: 25px 22px; border-radius: 15px; gap: 22px; }
    .bridge-title { font-size: 23px; line-height: 1.4; }
    .bridge-lead, .bridge-text { font-size: 14px; line-height: 1.75; }
    .problem-bridge .home-button { width: 100%; font-size: 12px; }
  }
  @media (max-width: 359px) {
    .problem-metrics { grid-template-columns: 1fr; padding: 22px 19px; }
    .problem-metric { padding-right: 0; }
    .problem-metric + .problem-metric { margin-top: 22px; padding: 22px 0 0; border-left: 0; border-top: 1px solid #e3ebe5; }
    .metric-label { align-self: flex-start; min-height: 0; }
    .problem-fact { font-size: 13px; max-width: none; }
  }
</style>
