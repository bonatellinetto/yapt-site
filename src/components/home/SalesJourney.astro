const commercialChapters: Record<Locale, string[]> = {
  'pt-BR':['IA na conversa','Prospecção','Negócios','Gestão','Metas e funil'],
  'en-US':['AI in context','Prospecting','Deals','Management','Targets and pipeline'],
  'es-ES':['IA en contexto','Prospección','Negocios','Gestión','Metas y embudo'],
};
const commercialReportCaption: Record<Locale, string> = {
  'pt-BR':'Uma rolagem pelas metas, pelo resultado dos vendedores e pelas etapas do funil comercial.',
  'en-US':'Explore targets, salespeople’s results and the stages of the sales pipeline.',
  'es-ES':'Un recorrido por las metas, los resultados de los vendedores y las etapas del embudo comercial.',
};
const journeyFrames: JourneyFrame[] = commercialOnly
  ? [...frames.slice(0,22), {...frames[22], chapter:4}, frames[27]]
  : frames;
const copy = copies[locale];
const journeyCopy: JourneyCopy = commercialOnly ? {
  ...copy,
  chapters:commercialChapters[locale],
  captions:[...copy.captions.slice(0,22), commercialReportCaption[locale], copy.captions[27]],
} : copy;
const chapterFrames = commercialOnly ? [3,7,13,21,22] : [3,7,13,21,25];
const staticLabels = {
  'pt-BR':['Conversa','IA','Prospecção','Negócio','Gestão'],
  'en-US':['Conversation','AI','Prospecting','Deal','Management'],
  'es-ES':['Conversación','IA','Prospección','Negocio','Gestión'],
}[locale];
const staticValues = {
  'pt-BR':['Contexto','Resumo','Prioridade','Histórico','Visibilidade'],
  'en-US':['Context','Summary','Priority','History','Visibility'],
  'es-ES':['Contexto','Resumen','Prioridad','Historial','Visibilidad'],
}[locale];
---
<ProductJourney locale={locale} variant="sales" copy={journeyCopy} frames={journeyFrames} chapterFrames={chapterFrames} staticLabels={staticLabels} staticValues={staticValues}>
  <SalesJourneyScreens includeEfficiency={!commercialOnly}/>
</ProductJourney>
