---
import ProductJourney from './ProductJourney.astro';
import SalesJourneyScreens from './SalesJourneyScreens.astro';
import type { Locale } from '../../lib/i18n';
import type { JourneyCopy, JourneyFrame } from '../../scripts/marketing-journey';
interface Props { locale: Locale; commercialOnly?: boolean }
