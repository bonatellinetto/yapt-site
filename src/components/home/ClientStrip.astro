---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels: Record<Locale, { highlight: string; text: string }> = {
  'pt-BR': { highlight: '+1.900 empresas', text: 'já confiaram sua operação à New Way' },
  'en-US': { highlight: '1,900+ companies', text: 'have trusted New Way with their operations' },
  'es-ES': { highlight: '+1.900 empresas', text: 'han confiado su operación a New Way' },
};
const label = labels[locale];

// Existing customer claim and brand assets from /solucao/crm-whatsapp-ia.
const clients = [
  { name: 'Natura', file: '8699d7137d73.png', width: 215, height: 162, displayHeight: 33 },
  { name: 'White Martins', file: '9608d1eaa9f0.png', width: 438, height: 120, displayHeight: 25 },
  { name: 'Nutrivet', file: 'b21f91429554.png', width: 582, height: 138, displayHeight: 26 },
  { name: 'Seanet', file: '6a4de923852c.png', width: 511, height: 108, displayHeight: 22 },
  { name: 'ML Gomes', file: '19935ed934f0.png', width: 542, height: 83, displayHeight: 17 },
  { name: 'Fleury', file: '20acab0f34c8.png', width: 262, height: 120, displayHeight: 28 },
  { name: 'Banco Daycoval', file: 'f496e942868d.png', width: 300, height: 39, displayHeight: 16 },
  { name: 'Volvo', file: '852d0f506a61.svg', width: 1040, height: 165.099, displayHeight: 18 },
];
---

<section class="client-strip" aria-labelledby="client-strip-caption">
  <p class="client-strip__caption" id="client-strip-caption"><strong>{label.highlight}</strong> {label.text}</p>
  <div class="client-strip__track" tabindex="0" role="group" aria-label={`${label.highlight} ${label.text}`}>
    <ul class="client-strip__logos">
      {clients.map((client) => (
        <li class="client-strip__brand">
          <img
            src={`/solucao/img/${client.file}`}
            alt={client.name}
            width={client.width}
            height={client.height}
            style={`--logo-height: ${client.displayHeight}px`}
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .client-strip {
    overflow: hidden;
    border-bottom: 1px solid rgba(67, 74, 84, .09);
    background: #fff;
    font-family: Poppins, sans-serif;
  }

  .client-strip__caption {
    max-width: 1100px;
    margin: 0 auto;
    padding: 21px 24px 0;
    color: #52776d;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: .1em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .client-strip__caption strong {
    color: #0b7168;
    font-weight: 600;
  }

  .client-strip__track {
    overflow-x: auto;
    padding: 16px 24px 23px;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: rgba(67, 74, 84, .22) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .client-strip__track:focus-visible {
    outline: 2px solid #0d9488;
    outline-offset: -3px;
  }

  .client-strip__logos {
    display: flex;
    align-items: center;
    gap: 28px;
    width: max-content;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .client-strip__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 104px;
    width: 104px;
    min-height: 38px;
    scroll-snap-align: center;
  }

  .client-strip__brand img {
    display: block;
    width: auto;
    max-width: 100%;
    height: var(--logo-height);
    object-fit: contain;
    filter: grayscale(1);
  }

  @media (max-width: 600px) {
    .client-strip__caption {
      padding: 18px 20px 0;
      font-size: 10px;
      letter-spacing: .07em;
    }

    .client-strip__track {
      padding-block: 15px 20px;
    }
  }

  @media (min-width: 1024px) {
    .client-strip__track {
      max-width: 1280px;
      margin: 0 auto;
      padding-inline: 40px;
      overflow-x: visible;
    }

    .client-strip__logos {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: clamp(20px, 3vw, 42px);
      width: 100%;
    }

    .client-strip__brand {
      width: 100%;
    }
  }
</style>
