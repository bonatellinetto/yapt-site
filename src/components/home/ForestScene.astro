---
import NatureGlyph from './NatureGlyph.astro';
import UIIcon from '../UIIcon.astro';
import { homeCopy, areaKeys, areaHref } from './content';
import type { Locale } from '../../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy(locale);
---

<div class="forest-scene" role="group" aria-label={c.hero.sceneLabel}>
  <svg class="scene-connections" viewBox="0 0 640 540" fill="none" aria-hidden="true">
    <g stroke="#9fe4c2" stroke-width="1.2" opacity=".42">
      <path d="M110 115C225 115 150 205 290 205"/><path d="M97 268H280"/><path d="M115 423C221 423 170 350 290 350"/>
      <path d="M530 120C430 120 475 207 355 207"/><path d="M548 277H370"/><path d="M525 423C426 423 464 350 354 350"/>
    </g>
    <g fill="#b5f8da"><circle cx="205" cy="163" r="3"/><circle cx="182" cy="268" r="3"/><circle cx="219" cy="388" r="3"/><circle cx="439" cy="163" r="3"/><circle cx="461" cy="277" r="3"/><circle cx="435" cy="389" r="3"/></g>
  </svg>
  <div class="scene-conversation">
    <div class="conversation-top"><span class="brand-symbol">y.</span><div><strong>yapt.</strong><span>{c.hero.chatRole}</span></div><i aria-hidden="true"></i></div>
    <div class="conversation-body">
      <p class="conversation-title">{c.hero.chatTitle}</p>
      <p class="message incoming">{c.hero.chatInbound}</p>
      <p class="message outgoing">{c.hero.chatOutbound}<span aria-hidden="true"><UIIcon name="check" size={10}/><UIIcon name="check" size={10}/></span></p>
      <div class="conversation-event"><span aria-hidden="true"><UIIcon name="arrow-up-right" size={16}/></span>{c.hero.chatEvent}</div>
    </div>
    <div class="conversation-bottom"><span aria-hidden="true"><UIIcon name="plus" size={18}/></span><div></div><span aria-hidden="true"><UIIcon name="circle" size={18}/></span></div>
  </div>
  {areaKeys.map((key) => (
    <a class={`scene-node node-${key}`} href={areaHref(key,locale)} aria-label={`${c.areas[key].label}: ${c.areas[key].phrase}`}>
      <NatureGlyph name={key} size={30} />
      <span>{c.areas[key].label}</span>
    </a>
  ))}
</div>

<style>
  .forest-scene{height:560px;position:relative;width:100%;isolation:isolate;min-width:0}
  .scene-connections{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .scene-conversation{position:absolute;left:50%;top:49%;width:47%;max-width:278px;transform:translate(-50%,-50%) rotate(-3deg);background:#f6f6ee;border:1px solid #fff8;border-radius:23px;box-shadow:0 30px 70px #002b3a55,0 0 0 6px #b8ecd209;overflow:hidden;z-index:2;transition:transform .5s}
  .conversation-top{display:flex;align-items:center;gap:10px;padding:15px;background:#fafff9;color:#123b37}
  .brand-symbol{width:31px;height:31px;border-radius:10px;background:#0d7568;color:#fff;display:grid;place-items:center;font:600 17px Poppins,sans-serif}
  .conversation-top strong{display:block;font:600 13px Poppins,sans-serif}.conversation-top div>span{display:block;font-size:9px;color:#648278;margin-top:1px}
  .conversation-top i{width:6px;height:6px;border-radius:50%;background:#28ae74;margin-left:auto}
  .conversation-body{padding:17px 13px 20px;background:radial-gradient(#164a3610 .7px,transparent .7px);background-size:13px 13px}
  .conversation-title{text-align:center;font-size:8px;color:#6b837b;margin:0 0 22px;letter-spacing:.03em}
  .message{padding:12px;border-radius:12px;font-size:11px;line-height:1.6;color:#254b41;box-shadow:0 2px 3px #123b3705;margin:0}
  .incoming{background:#fff;max-width:88%;border-bottom-left-radius:3px}
  .outgoing{background:#ddf2d4;margin:12px 0 0 10%;border-bottom-right-radius:3px}.outgoing>span{display:flex;justify-content:flex-end;color:#358d9c;font-size:10px;margin-top:4px}
  .conversation-event{display:flex;gap:7px;align-items:center;margin-top:22px;font-size:8px;line-height:1.5;color:#4b7765;padding:8px;border:1px solid #b7d0b1;border-radius:8px;background:#f3f8eccc}
  .conversation-event>span{font-size:16px;color:#228062}
  .conversation-bottom{display:flex;gap:9px;align-items:center;padding:12px;color:#688277;background:#fafff9;font-size:18px}.conversation-bottom>div{height:23px;border-radius:20px;background:#e8eeea;flex:1}
  .conversation-bottom>span :global(svg),.conversation-event>span :global(svg){width:1em;height:1em}
  .scene-node{position:absolute;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;width:106px;min-height:83px;padding:12px 9px;border-radius:18px;text-decoration:none;color:#f4fff7;border:1px solid #c2f5de3d;background:linear-gradient(140deg,#e3ffe61f,#e3ffe609);box-shadow:0 10px 30px #001e2620,inset 0 1px #ffffff12;backdrop-filter:blur(8px);font:500 11px Poppins,sans-serif;transition:transform .3s,background .3s,border-color .3s;z-index:3}
  .scene-node:hover,.scene-node:focus-visible{transform:translateY(-5px);background:#e8fff82e;border-color:#b6f9d9;outline-offset:4px}
  .node-marketing{left:2%;top:13%}.node-sales{left:0;top:43%}.node-support{left:3%;bottom:10%}.node-operations{right:1%;top:14%}.node-ai{right:0;top:44%}.node-teams{right:4%;bottom:9%}
  @media(min-width:1024px) and (hover:hover){.forest-scene:hover .scene-conversation{transform:translate(-50%,-50%) rotate(-1deg)}}
  @media(max-width:1023px){.forest-scene{height:490px;max-width:580px;margin:auto}.scene-conversation{width:45%}}
  @media(max-width:600px){.forest-scene{height:396px;max-width:410px}.scene-conversation{width:49%;border-radius:17px}.conversation-top{padding:10px;gap:6px}.brand-symbol{width:24px;height:24px;font-size:13px}.conversation-top strong{font-size:11px}.conversation-top div>span{font-size:8px}.conversation-body{padding:12px 9px}.conversation-title{font-size:7px;margin-bottom:13px}.message{font-size:9px;padding:9px;line-height:1.55}.conversation-event{font-size:7px;padding:5px;margin-top:13px;gap:4px}.conversation-bottom{padding:8px;font-size:14px}.conversation-bottom>div{height:18px}.scene-node{width:77px;min-height:64px;padding:9px 5px;gap:5px;border-radius:13px;font-size:9px;backdrop-filter:none;background:rgba(6,78,59,.58)}.scene-node :global(img){width:24px;height:24px}.node-marketing{left:0;top:12%}.node-sales{left:0;top:43%}.node-support{left:0;bottom:10%}.node-operations{right:0;top:13%}.node-ai{right:0;top:44%}.node-teams{right:0;bottom:10%}.scene-note{font-size:8px}}
  @media(max-width:370px){.scene-node{width:68px;font-size:8px}.scene-conversation{width:48%}.conversation-event{font-size:6px}}
  @media(prefers-reduced-motion:reduce){.scene-node,.scene-conversation{transition:none}}
</style>
