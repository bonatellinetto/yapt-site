---
interface Props { idPrefix?: string }
const { idPrefix = '' } = Astro.props;
import './support-management-scenes.css';
const stages = [
  {name:'Triagem',count:2,color:'#6a84bb'},
  {name:'Em atendimento',count:3,color:'#4ba6a0'},
  {name:'Aguardando cliente',count:1,color:'#c49b4e'},
  {name:'Monitoramento',count:0,color:'#8e7abb'},
  {name:'Resolvido',count:4,color:'#449a75'},
  {name:'Encerrado',count:3,color:'#818b93'},
];
const conversations = [
  {name:'Caio Cavalcanti',number:'801630',preview:'#T-1042 · Instalação dos headsets: precisamos confirmar o ajuste com a equipe.',stage:'Em atendimento',agent:'Ana',time:'2min',active:true,channel:'whatsapp'},
  {name:'Isabela Melo',number:'801856',preview:'Gostaria de acompanhar o chamado que já está em aberto.',stage:'Triagem',agent:'Maria',time:'4min',channel:'instagram'},
  {name:'Felipe Duarte',number:'800736',preview:'Enviei a documentação solicitada. Podemos continuar o atendimento.',stage:'Em atendimento',agent:'Ana',time:'8min',channel:'whatsapp'},
  {name:'Mariana Almeida',number:'800000',preview:'Obrigada! Estou verificando a orientação com o nosso time.',stage:'Aguardando cliente',agent:'João',time:'18min',channel:'whatsapp'},
  {name:'Juliana Almeida',number:'800006',preview:'Precisamos de ajuda para concluir a configuração.',stage:'Triagem',agent:'Lucas',time:'5min',channel:'chat'},
  {name:'Patrícia Almeida',number:'800012',preview:'Vou enviar os dados para a análise técnica.',stage:'Em atendimento',agent:'Maria',time:'12min',channel:'chat'},
];
const globalTabs = ['Visão Geral','Atendimento','Vendas','Eficiência dos funis','Suporte','Marketing','Disparos','Agentes','IA','Pesquisas','Exportar Dados'];
---
<svg class="spm-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
  <symbol id={`${idPrefix}spm-i-chat`} viewBox="0 0 24 24"><path d="M3 3h18v14H8l-5 4Z"/><path d="M7 7h10M7 11h6"/></symbol>
  <symbol id={`${idPrefix}spm-i-instagram`} viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></symbol>
  <symbol id={`${idPrefix}spm-i-whatsapp`} viewBox="0 0 24 24"><path d="M20.6 15.5A9 9 0 0 1 7 20.1L2 22l1.8-5A9 9 0 1 1 20.6 15.5Z"/><path d="m8 7-1 2c1 4 3 6 7 7l2-1-2-3-2 1-2-2 1-2Z"/></symbol>
  <symbol id={`${idPrefix}spm-i-person`} viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></symbol>
  <symbol id={`${idPrefix}spm-i-clock`} viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></symbol>
  <symbol id={`${idPrefix}spm-i-headphones`} viewBox="0 0 24 24"><path d="M4 14v-3a8 8 0 0 1 16 0v3M4 12H2v8h5v-8Zm16 0h2v8h-5v-8Z"/></symbol>
  <symbol id={`${idPrefix}spm-i-arrow`} viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol>
  <symbol id={`${idPrefix}spm-i-calendar`} viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 2v6m8-6v6M3 11h18"/></symbol>
  <symbol id={`${idPrefix}spm-i-download`} viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M3 16v5h18v-5"/></symbol>
  <symbol id={`${idPrefix}spm-i-chart`} viewBox="0 0 24 24"><path d="M3 3v18h18M7 15v-4m5 4V7m5 8V5"/></symbol>
</defs></svg>

<div class="sp-screen spm-scene spm-pipelines-screen" data-j-screen="support-pipelines">
  <div class="spm-workspace" data-j-target="support-pipelines-overview">
    <img class="spm-workspace-base" src="/produto/ops-conversas.webp" width="1600" height="896" alt="" decoding="async"/>
    <div class="spm-selected-sector"><svg class="spm-icon"><use href={`#${idPrefix}spm-i-headphones`}/></svg><strong>Suporte</strong><b>6 <span>/ 13</span></b></div>
    <div class="spm-pipeline-sectors"><span class="spm-tab-arrow">‹</span><span class="spm-all-sector">Todos</span><span><i></i>Vendas e novos clientes <b>80</b><small>Operação fictícia: Vendas e atendimento</small></span><span><i></i>Financeiro e cobrança <b>61</b><small>Operação fictícia: Financeiro</small></span><span class="spm-sector-active"><svg class="spm-icon"><use href={`#${idPrefix}spm-i-headphones`}/></svg>Suporte <b>6 <em>/ 13</em></b></span><span><i></i>Relacionamento B2B <b>0</b></span><span class="spm-tab-arrow">›</span></div>
    <div class="spm-support-stages"><span class="spm-hotspot spm-stage-focus" data-j-target="support-pipeline-stages"></span><span class="spm-tab-arrow">‹</span><div>{stages.map(stage => <span><i style={`background:${stage.color}`}></i><strong>{stage.name}</strong><b>{stage.count}</b></span>)}</div><span class="spm-tab-arrow">›</span></div>
    <div class="spm-conversation-grid">{conversations.map(conversation => <div class={`spm-conversation-card ${conversation.active?'spm-current-conversation':''}`}><header><svg class={`spm-icon spm-channel-${conversation.channel}`}><use href={`#${idPrefix}spm-i-${conversation.channel}`}/></svg><strong>{conversation.name}</strong><small>#C-{conversation.number}</small><span class="spm-open-status">Aberta</span></header><p>{conversation.preview}</p><footer><span class="spm-lifecycle">Cliente</span><span class="spm-card-stage"><i></i>{conversation.stage}</span><span class="spm-card-agent"><svg class="spm-icon"><use href={`#${idPrefix}spm-i-person`}/></svg>{conversation.agent}</span><span class="spm-card-time"><svg class="spm-icon"><use href={`#${idPrefix}spm-i-clock`}/></svg>{conversation.time}</span></footer></div>)}</div>
  </div>
</div>

<div class="sp-screen spm-scene spm-queues-screen" data-j-screen="support-queues">
  <div class="spm-simple-header"><span><svg class="spm-icon"><use href={`#${idPrefix}spm-i-headphones`}/></svg></span><strong>Filas</strong><div><b>Radar</b><span>Regras</span><span>Experiência</span></div></div>
  <div class="spm-queues-capture" data-j-target="support-queues-overview"><img src="/produto/ops-filas.webp" width="1600" height="670" alt="" decoding="async"/><span class="spm-hotspot spm-waiting-time" data-j-target="support-waiting-time"></span></div>
</div>

<div class="sp-screen spm-scene spm-capacity-screen" data-j-screen="support-capacity">
  <div class="spm-simple-header"><span><svg class="spm-icon"><use href={`#${idPrefix}spm-i-headphones`}/></svg></span><strong>Filas</strong><div><b>Radar</b><span>Regras</span><span>Experiência</span></div></div>
  <div class="spm-capacity-capture" data-j-target="support-capacity-overview"><img src="/produto/ops-equipe.webp" width="1600" height="1057" alt="" decoding="async"/><span class="spm-hotspot spm-operator-capacity" data-j-target="support-operator-capacity"></span></div>
</div>

<div class="sp-screen spm-scene spm-distribution-screen" data-j-screen="support-distribution">
  <div class="spm-distribution-backdrop"><img src="/produto/ops-filas.webp" width="1600" height="670" alt="" decoding="async"/></div><div class="spm-shade"></div>
  <div class="spm-distribution-capture" data-j-target="support-distribution-overview"><img src="/produto/ops-distribuicao.jpg" width="720" height="992" alt="" decoding="async"/><span class="spm-hotspot spm-routing-rules" data-j-target="support-routing-rules"></span></div>
</div>

<div class="sp-screen spm-scene spm-reports-screen" data-j-screen="support-report" data-j-target="support-report-overview">
  <div class="spm-report-pane spm-report-support">
    <div class="spm-report-top-strip"><img src="/produto/ops-indicadores-suporte.webp" width="1600" height="692" alt="" decoding="async"/></div>
    <div class="spm-report-heading"><div><h2><svg class="spm-icon"><use href={`#${idPrefix}spm-i-chart`}/></svg>Painel de Suporte</h2><p>Acompanhamento de performance — antes vs depois</p></div><div><span><svg class="spm-icon"><use href={`#${idPrefix}spm-i-calendar`}/></svg>12/10/2026</span><span>até</span><span>11/11/2026</span></div></div>
    <div class="spm-support-report-capture"><img src="/produto/ops-indicadores-suporte.webp" width="1600" height="692" alt="" decoding="async"/><span class="spm-hotspot spm-resolution" data-j-target="support-resolution"></span></div>
  </div>
  <div class="spm-report-pane spm-report-service">
    <div class="spm-report-top-strip"><img src="/produto/ops-indicadores-atendimento.webp" width="1600" height="513" alt="" decoding="async"/></div>
    <div class="spm-service-heading"><h2><svg class="spm-icon"><use href={`#${idPrefix}spm-i-chat`}/></svg>Atendimento</h2><div><span><svg class="spm-icon"><use href={`#${idPrefix}spm-i-calendar`}/></svg>12/10/2026</span><span>até</span><span>11/11/2026</span><span>Todos os canais</span><span>Todos os setores</span></div></div>
    <div class="spm-service-report-capture"><img src="/produto/ops-indicadores-atendimento.webp" width="1600" height="513" alt="" decoding="async"/><span class="spm-hotspot spm-response-times" data-j-target="support-response-times"></span></div>
  </div>
  <div class="spm-report-pane spm-report-team">
    <div class="spm-analytics-tabs">{globalTabs.map(label => <span class={label==='Agentes'?'spm-analytics-current':''}>{label}</span>)}</div>
    <div class="spm-team-heading"><h2><svg class="spm-icon"><use href={`#${idPrefix}spm-i-person`}/></svg>Relatório de Agentes</h2><p>Ranking, performance individual e produtividade</p><div><span><svg class="spm-icon"><use href={`#${idPrefix}spm-i-calendar`}/></svg>12/10/2026</span><span>até</span><span>11/11/2026</span><span>Todos os agentes</span><span>Todos os canais</span></div></div>
    <div class="spm-agent-tabs"><b>Ranking</b><span>Individual</span><span>Produtividade</span></div>
    <div class="spm-ranking-tools"><span><svg class="spm-icon"><use href={`#${idPrefix}spm-i-download`}/></svg>CSV</span></div>
    <div class="spm-ranking-capture"><img src="/solucao/img/714d3d2420f7.jpg" width="940" height="555" alt="" decoding="async"/><span class="spm-hotspot spm-team-metrics" data-j-target="support-team-metrics"></span></div>
  </div>
</div>

<div class="sp-screen spm-scene spm-efficiency-screen" data-j-screen="support-efficiency">
  <div class="spm-efficiency-capture" data-j-target="support-efficiency-overview"><img src="/produto/demo-vendas-eficiencia.webp" width="2458" height="2308" alt="" decoding="async"/></div>
</div>
