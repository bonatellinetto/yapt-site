---
import './sales-journey-screens.css';
import SalesWorkspaceScenes from './SalesWorkspaceScenes.astro';
import SalesDealsScenes from './SalesDealsScenes.astro';
import SalesReportScene from './SalesReportScene.astro';
interface Props { includeEfficiency?: boolean }
const { includeEfficiency = true } = Astro.props;
---
<div class="sj-ui" lang="pt-BR">
  <svg class="sj-icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
    <symbol id="sj-i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10H14v-7h-4v7H3Z"/></symbol>
    <symbol id="sj-i-chat" viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H5l-3 2v-8.5A8.5 8.5 0 0 1 10.5 5h2A8.5 8.5 0 0 1 21 11.5Z"/><path d="M7 10h9M7 14h6"/></symbol>
    <symbol id="sj-i-users" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2m6 0v-2a4 4 0 0 0-3-4m-3-12a4 4 0 0 1 0 8"/></symbol>
    <symbol id="sj-i-board" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16m6-16v16M3 9h6m0 4h6m0-5h6"/></symbol>
    <symbol id="sj-i-megaphone" viewBox="0 0 24 24"><path d="m3 9 15-5v16L3 15Zm4 7 1 5h4l-2-4M21 8v8"/></symbol>
    <symbol id="sj-i-chart" viewBox="0 0 24 24"><path d="M3 3v18h18M7 15v-4m5 4V7m5 8v-6"/></symbol>
    <symbol id="sj-i-chevron" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol>
    <symbol id="sj-i-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
    <symbol id="sj-i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="sj-i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
    <symbol id="sj-i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="sj-i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></symbol>
    <symbol id="sj-i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol>
    <symbol id="sj-i-filter" viewBox="0 0 24 24"><path d="M4 5h16l-6 7v7l-4 2v-9Z"/></symbol>
    <symbol id="sj-i-more" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></symbol>
    <symbol id="sj-i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol>
    <symbol id="sj-i-settings" viewBox="0 0 24 24"><path d="m9 3-1 3-3 1-2 4 2 2v4l4 2 3-1 3 1 4-2v-4l2-2-2-4-3-1-1-3Z"/><circle cx="12" cy="11" r="3"/></symbol>
    <symbol id="sj-i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 8a2.5 2.5 0 1 1 4.2 1.8c-1.2.7-1.7 1.2-1.7 2.7M12 16h.01"/></symbol>
    <symbol id="sj-i-phone" viewBox="0 0 24 24"><path d="m7 3 3 5-3 3a17 17 0 0 0 6 6l3-3 5 3-1 4C10 22 2 14 3 4Z"/></symbol>
    <symbol id="sj-i-note" viewBox="0 0 24 24"><path d="M14 3H5v18h14V8Zm0 0v5h5M8 12h8m-8 4h5"/></symbol>
    <symbol id="sj-i-link" viewBox="0 0 24 24"><path d="m10 13 4-4m-6 6-1 1a4 4 0 0 1-6-6l5-5a4 4 0 0 1 6 0m0 4 1-1a4 4 0 0 1 6 6l-5 5a4 4 0 0 1-6 0"/></symbol>
    <symbol id="sj-i-sparkles" viewBox="0 0 24 24"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5ZM20 2v4m-2-2h4"/></symbol>
    <symbol id="sj-i-whatsapp" viewBox="0 0 24 24"><path d="M20.6 15.5A9 9 0 0 1 7 20.1L2 22l1.8-5A9 9 0 1 1 20.6 15.5Z"/><path d="m8 7-1 2c1 4 3 6 7 7l2-1-2-3-2 1-2-2 1-2Z"/></symbol>
    <symbol id="sj-i-play" viewBox="0 0 24 24"><path d="m8 4 13 8-13 8Z"/></symbol>
    <symbol id="sj-i-attachment" viewBox="0 0 24 24"><path d="m8 12 7-7a4 4 0 0 1 6 6L10 22a6 6 0 0 1-8-8L13 3m-8 14 10-10"/></symbol>
    <symbol id="sj-i-send" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9L2 9Zm0 0L11 13"/></symbol>
    <symbol id="sj-i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
    <symbol id="sj-i-download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></symbol>
    <symbol id="sj-i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></symbol>
    <symbol id="sj-i-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></symbol>
    <symbol id="sj-i-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 5 10 8L22 5"/></symbol>
    <symbol id="sj-i-star" viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2-5.5-2.9-5.5 2.9 1-6.2L3 9.6l6.2-.9Z"/></symbol>
    <symbol id="sj-i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></symbol>
    <symbol id="sj-i-dollar" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8m4-11v14"/></symbol>
    <symbol id="sj-i-cap" viewBox="0 0 24 24"><path d="m2 8 10-5 10 5-10 5Zm4 2v7q6 5 12 0v-7m4-2v8"/></symbol>
<symbol id="sj-nav-calendar" viewBox="0 0 24 24"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="m9 16 2 2 4-4"></path></symbol>
<symbol id="sj-nav-branch" viewBox="0 0 24 24"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></symbol>
<symbol id="sj-nav-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></symbol>
<symbol id="sj-nav-chart" viewBox="0 0 24 24"><path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></symbol>
<symbol id="sj-nav-deals" viewBox="0 0 100 100">    <path d="M20 70 L40 50 L55 60 L80 30" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="80" cy="30" r="8" fill="currentColor" />
  </symbol>
<symbol id="sj-nav-sales" viewBox="0 0 100 100">    <circle cx="50" cy="50" r="32" stroke="currentColor" stroke-width="5" />
    <path d="M50 30 L50 70" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
    <path d="M38 40 C38 35, 45 32, 50 32 C55 32, 62 35, 62 40 C62 46, 55 48, 50 50 C45 52, 38 54, 38 60 C38 65, 45 68, 50 68 C55 68, 62 65, 62 60" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none" />
  </symbol>
<symbol id="sj-nav-products" viewBox="0 0 100 100">    <circle cx="50" cy="50" r="30" stroke="currentColor" stroke-width="5" />
    <ellipse cx="50" cy="50" rx="12" ry="30" stroke="currentColor" stroke-width="4" />
    <path d="M20 50 L80 50" stroke="currentColor" stroke-width="4" />
    <path d="M25 35 L75 35" stroke="currentColor" stroke-width="3" />
    <path d="M25 65 L75 65" stroke="currentColor" stroke-width="3" />
  </symbol>
<symbol id="sj-nav-workspace" viewBox="0 0 100 100">    <rect x="15" y="15" width="70" height="52" rx="10" stroke="currentColor" stroke-width="5" />
    <path d="M30 67 L30 82 L48 67" stroke="currentColor" stroke-width="5" stroke-linejoin="round" />
    <path d="M32 35 L68 35" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <path d="M32 47 L58 47" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
  </symbol>
<symbol id="sj-nav-marketing" viewBox="0 0 100 100">    <path d="M15 45L75 25V75L15 55V45Z" stroke="currentColor" stroke-width="5" stroke-linejoin="round" />
    <path d="M48 68A12 12 0 1 1 24 62" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
  </symbol>
<symbol id="sj-nav-operations" viewBox="0 0 100 100">    <circle cx="50" cy="50" r="38" stroke="currentColor" stroke-width="5" />
    <circle cx="50" cy="50" r="24" stroke="currentColor" stroke-width="5" />
    <circle cx="50" cy="50" r="8" fill="currentColor" />
    <path d="M50 12 L50 26" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
    <path d="M50 74 L50 88" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
    <path d="M12 50 L26 50" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
    <path d="M74 50 L88 50" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
  </symbol>
  </defs></svg>

  <div class="sj-rail">
    <div class="sj-brand"><img src="/produto/app-icon.svg" width="32" height="32" alt="" /></div>
    <div class="sj-rail-links">
      <span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-i-star"/></svg></span>
      <span class="sj-rail-item sj-workspace-rail" data-j-target="menu-workspace"><svg class="sj-icon"><use href="#sj-nav-workspace"/></svg></span>
      <span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-nav-marketing"/></svg></span>
      <span class="sj-rail-item sj-sales-rail" data-j-target="menu-sales"><svg class="sj-icon"><use href="#sj-nav-sales"/></svg></span>
      <span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-nav-operations"/></svg></span>
      <span class="sj-rail-item sj-reports-rail" data-j-target="menu-reports"><svg class="sj-icon"><use href="#sj-i-grid"/></svg></span>
    </div>
    <div class="sj-rail-bottom"><span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-i-cap"/></svg></span><span class="sj-rail-item sj-teams-icon">＠</span><span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-i-help"/></svg></span><span class="sj-bottom-divider"></span><span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-i-star"/></svg></span><span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-i-bell"/></svg></span><span class="sj-rail-item"><svg class="sj-icon"><use href="#sj-i-settings"/></svg></span><span class="sj-avatar">NB</span><small>v1.558.0</small></div>
  </div>
  <div class="sj-flyout sj-flyout-reference">
    <img class="sj-menu-reference" src="/produto/menu-vendas-real.png" width="768" height="1702" alt="" decoding="async"/>
    <div class="sj-flyout-heading"><strong>Vendas</strong><svg class="sj-icon"><use href="#sj-i-close"/></svg></div>
    <div class="sj-flyout-links">{[{"name":"Meu dia","icon":"calendar","description":"Sua fila do dia: o que fazer com cada negócio e em que ordem."},{"name":"Negócios","icon":"deals","target":"nav-deals","description":"Acompanhe cada oportunidade do primeiro contato até o fechamento."},{"name":"Réguas","icon":"branch","description":"Réguas de negócios e modelos prontos para vendas: proposta sem resposta, negócio esfriando e pós-venda."},{"name":"Vendas","icon":"sales","description":"Registre e acompanhe as vendas consolidadas da sua empresa."},{"name":"Importar vendas","icon":"sales","description":"Suba sua planilha de vendas e traga o histórico para o yapt."},{"name":"Metas","icon":"target","description":"Defina metas por vendedor e equipe e acompanhe o avanço no mês."},{"name":"Relatório","icon":"chart","target":"nav-sales-report","description":"Meta do mês, resultado por vendedor, funil por etapa e motivos de perda."},{"name":"Produtos","icon":"products","description":"Catálogo de produtos e serviços usado nas conversas e nas vendas."}].map(item => <div class="sj-flyout-item" data-j-target={item.target}><svg class="sj-icon"><use href={`#sj-nav-${item.icon}`}/></svg><span><strong>{item.name}</strong><small>{item.description}</small></span></div>)}</div>
  </div>
  <SalesWorkspaceScenes/>
  <SalesDealsScenes/>
  <SalesReportScene/>
  {includeEfficiency && ['efficiency-select', 'efficiency'].map(screen => <div class="sj-screen sj-efficiency-screen" data-j-screen={screen}><div class="sj-efficiency-capture" data-j-target={screen === 'efficiency' ? 'efficiency-overview' : undefined}><img class={screen === 'efficiency' ? 'sj-efficiency-image sj-efficiency-image-scroll' : 'sj-efficiency-image'} src="/produto/demo-vendas-eficiencia.webp" width="2458" height="2308" alt="" /></div>{screen === 'efficiency-select' && <div class="sj-efficiency-dropdown"><div class="sj-efficiency-filter"><strong>Suporte e garantia • Showcase</strong><svg class="sj-icon"><use href="#sj-i-down"/></svg></div><div class="sj-efficiency-options"><div class="sj-search"><svg class="sj-icon"><use href="#sj-i-search"/></svg>Buscar funil...</div><span>Financeiro</span><span>Implantação</span><span class="sj-efficiency-option-selected" data-j-target="efficiency-support-option"><svg class="sj-icon"><use href="#sj-i-check"/></svg>Suporte e garantia • Showcase</span></div></div>}</div>)}
</div>
