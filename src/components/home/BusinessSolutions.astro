---
import NatureGlyph from './NatureGlyph.astro';
import UIIcon from '../UIIcon.astro';
import MarketingJourney from './MarketingJourney.astro';
import SalesJourney from './SalesJourney.astro';
import SupportJourney from './SupportJourney.astro';
import OperationsJourney from './OperationsJourney.astro';
import { homeCopy, type AreaKey } from './content';
import { localePath, type Locale } from '../../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy(locale).solutions;
---
<section class="home-section business-solutions" aria-labelledby="solutions-heading">
  <div class="home-shell">
    <div class="home-section-head home-reveal"><div><p class="home-label">{c.eyebrow}</p><h2 class="home-heading" id="solutions-heading">{c.title}</h2></div><p class="home-intro">{c.description}</p></div>
  </div>
  <div class="solution-stories">
      {c.items.map((item, index) => (
        <article id={item.id} class={`solution-story story-${item.key}`}>
          <div class="home-shell solution-layout">
          <div class="solution-copy home-reveal">
            <div class="solution-area"><NatureGlyph name={item.key as AreaKey} size={27} /><span>{item.label}</span><span class="solution-sequence">0{index + 1}</span></div>
            <h3>{item.title}</h3>
            <p>{item.answer}</p>
            <ul>{item.bullets.map(bullet => {
              const separator = bullet.indexOf(':');
              return <li><span>{separator === -1 ? bullet : <><strong>{bullet.slice(0, separator + 1)}</strong>{bullet.slice(separator + 1)}</>}</span></li>;
            })}</ul>
            <a class="home-link" href={localePath(item.href,locale)}>{item.link}</a>
          </div>
          <div class="solution-visual home-reveal">
            {item.key === 'marketing' ? <MarketingJourney locale={locale}/> : item.key === 'sales' ? <SalesJourney locale={locale}/> : item.key === 'support' ? <SupportJourney locale={locale}/> : item.key === 'operations' ? <OperationsJourney locale={locale}/> : <><div class="screen-caption"><span></span>{c.screenLabel}<span aria-hidden="true"><UIIcon name="arrow-up-right" size={16}/></span></div><a class="solution-image" href={item.image} target="_blank" rel="noopener noreferrer" aria-label={item.alt}><img src={item.image} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async"/></a></>}
            <div class="visual-orbit" aria-hidden="true"><NatureGlyph name={item.key as AreaKey} size={115}/></div>
          </div>
          </div>
        </article>
      ))}
  </div>
</section>
<style>
  .business-solutions{padding-bottom:0;background:#fff}
  .business-solutions .home-section-head{display:block;margin-bottom:48px}
  .business-solutions .home-heading{max-width:29ch}
  .business-solutions .home-intro{max-width:68ch;margin:22px 0 0}
  .solution-stories{border-top:1px solid #e5e9e1}
  .solution-story{padding-block:70px 80px;border-bottom:1px solid #dfe8e1;background:var(--story-surface)}
  .story-marketing{--story-surface:#faf6eb}.story-sales{--story-surface:#edf5f1}.story-support{--story-surface:#eef3f8}.story-operations{--story-surface:#f1f5eb}
  .solution-layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:70px;align-items:center}
  .solution-story:nth-child(even) .solution-layout{direction:rtl}.solution-layout>*{direction:ltr}
  .solution-copy{min-width:0}.solution-area{display:flex;align-items:center;gap:11px;color:#416b5b;font-size:11px;font-weight:600;letter-spacing:.06em;margin-bottom:23px}.solution-sequence{color:#abc0b1;font-weight:400;letter-spacing:.1em;margin-left:auto}.solution-copy h3{font:600 clamp(27px,3vw,40px)/1.22 Poppins,sans-serif;letter-spacing:-.045em;max-width:20ch;margin:0;text-wrap:balance}.solution-copy>p{font-size:14px;line-height:1.85;color:#607369;margin:24px 0 0}.solution-copy ul{list-style:none;padding:0;margin:24px 0 20px;display:grid;gap:14px}.solution-copy li{font-size:12px;line-height:1.7;color:#496354;display:flex;align-items:flex-start;gap:10px}.solution-copy li>span{min-width:0;overflow-wrap:break-word}.solution-copy li strong{font-weight:600;color:#315441}.solution-copy li:before{content:"";width:4px;height:4px;background:#3e9975;flex-shrink:0;margin-top:8px;border-radius:50%}.solution-copy .home-link{font-size:13px}
  .solution-visual{position:relative;border-radius:26px;min-width:0;padding:33px 22px 45px;background:linear-gradient(150deg,#f1f6ee,#e5eee2);isolation:isolate;overflow:hidden}.story-marketing .solution-visual{background:linear-gradient(140deg,#f9f5e8,#f5eeda)}.story-support .solution-visual{background:linear-gradient(140deg,#eff2f7,#e3eef0)}.screen-caption{display:flex;align-items:center;gap:7px;font-size:9px;color:#6f826a;letter-spacing:.03em;margin-bottom:25px}.screen-caption>span:first-child{width:4px;height:4px;background:#81a77a;border-radius:50%}.screen-caption>span:last-child{margin-left:auto;font-size:16px}.solution-image{display:block;position:relative;z-index:2;background:#fff;border:1px solid #e2e9de;box-shadow:0 25px 35px -20px #1f462550;border-radius:12px;overflow:hidden;transition:transform .35s}.solution-image img{display:block;width:100%;height:auto}.solution-image:hover{transform:translateY(-3px)}.visual-orbit{position:absolute;right:-17px;bottom:-40px;opacity:.12;transform:rotate(-10deg);z-index:-1}
  @media(max-width:1023px){.solution-layout{gap:36px}.solution-copy h3{font-size:30px}.solution-visual{padding:25px 15px 35px;border-radius:19px}}
  @media(max-width:767px){.solution-story{padding-block:40px 46px}.solution-layout{grid-template-columns:minmax(0,1fr);gap:28px}.solution-story:nth-child(even) .solution-layout{direction:ltr}.solution-copy h3{font-size:30px;max-width:23ch}.solution-copy>p{font-size:15px;line-height:1.75;margin-top:20px}.solution-copy li{font-size:13px}.solution-copy .home-link{font-size:13px}.solution-area{margin-bottom:18px}.solution-visual{padding:19px 14px 28px;border-radius:18px}.screen-caption{margin-bottom:17px;font-size:9px}.solution-image{border-radius:8px}.business-solutions .home-section-head{margin-bottom:34px}.business-solutions .home-heading{max-width:24ch}.business-solutions .home-intro{margin-top:20px}}
  .story-marketing .solution-visual,.story-sales .solution-visual,.story-support .solution-visual,.story-operations .solution-visual{padding:22px;overflow:visible}.story-marketing .visual-orbit,.story-sales .visual-orbit,.story-support .visual-orbit,.story-operations .visual-orbit{right:0;bottom:0;overflow:hidden;max-width:115px;max-height:115px;border-bottom-right-radius:26px}
  @media(max-width:767px){.story-marketing .solution-visual,.story-sales .solution-visual,.story-support .solution-visual,.story-operations .solution-visual{padding:16px 14px 12px}}
</style>
