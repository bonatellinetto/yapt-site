---
import './operations-monitor-scenes.css';
---

<div class="op-screen opm-screen" data-j-screen="operations-monitor">
  <div class="opm-capture" data-j-target="operations-monitor-overview">
    <img src="/produto/ops-monitoria-real.png" width="3488" height="2286" alt="" decoding="async" />
    <span class="opm-hotspot opm-ai-human" data-j-target="operations-ai-human" aria-hidden="true"></span>
    <span class="opm-hotspot opm-ai-flow" data-j-target="operations-ai-flow" aria-hidden="true"></span>
    <span class="opm-hotspot opm-human-flow" data-j-target="operations-human-flow" aria-hidden="true"></span>
    <span class="opm-hotspot opm-backlog" data-j-target="operations-backlog" aria-hidden="true"></span>
    <span class="opm-hotspot opm-waiting" data-j-target="operations-waiting" aria-hidden="true"></span>
    <span class="opm-hotspot opm-queue-health" data-j-target="operations-queue-health" aria-hidden="true"></span>
  </div>
</div>

<div class="op-screen opm-screen opm-followup-screen" data-j-screen="operations-followup">
  <div class="opm-capture" data-j-target="operations-followup-overview">
    <img src="/produto/ops-monitoria-real.png" width="3488" height="2286" alt="" decoding="async" />
  </div>
</div>
