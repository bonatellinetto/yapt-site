---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BusinessAreaVisual from './BusinessAreaVisual.astro';
import { businessPages, businessCommon, type BusinessArea } from '../../lib/business-pages';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
  area: BusinessArea;
  locale: Locale;
}

const { area, locale } = Astro.props;
const content = businessPages[area][locale];
const common = businessCommon[locale];
const diagnosticUrl = localePath('/#diagnostico', locale);
---

<SiteLayout title={content.meta.title} description={content.meta.description} path={`/${area}`} locale={locale}>
  <main class:list={['business-area-page', area]}>
    <section class="business-hero" aria-labelledby="business-heading">
      <svg class="hero-leaves" viewBox="0 0 290 410" fill="none" aria-hidden="true">
        <path d="M288 4C159 155 190 244 8 410" stroke="currentColor" stroke-width="1.2" />
        <path d="M222 88c-80-66-130-55-126-33 4 35 65 46 126 33Zm-38 108c-92-44-139-23-129 0 13 30 81 33 129 0Zm-38 73c-9-92 20-139 40-125 28 20 15 79-40 125Z" fill="currentColor" opacity=".35" />
      </svg>
      <div class="business-shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span aria-hidden="true"></span>{content.label}</p>
          <h1 id="business-heading" class="font-poppins">{content.title} <span>{content.emphasis}</span></h1>
          <p class="hero-intro">{content.intro}</p>
          <div class="hero-actions">
            <a class="business-button primary" href={diagnosticUrl}>{common.diagnose}<span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#capacidades">{common.explore}<span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-visual"><BusinessAreaVisual area={area} content={content.visual} /></div>
      </div>
      <div class="business-shell promise-row"><span aria-hidden="true">✳</span><p>{content.promise}</p></div>
    </section>

    <section id="capacidades" class="capabilities business-section" aria-labelledby="capabilities-heading">
      <div class="business-shell">
        <div class="section-intro">
          <h2 id="capabilities-heading" class="font-poppins">{content.capabilitiesTitle}</h2>
          <p>{content.capabilitiesIntro}</p>
        </div>
        <div class="capability-grid">
          {content.capabilities.map((capability, index) => (
            <article class="capability">
              <span class="capability-number" aria-hidden="true">0{index + 1}</span>
              <h3 class="font-poppins">{capability.title}</h3>
              <p>{capability.description}</p>
              <span class="capability-detail">{capability.detail}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="product-proof business-section" aria-labelledby="proof-heading">
      <div class="business-shell">
        <div class="proof-intro">
          <p class="eyebrow">{content.proof.eyebrow}</p>
          <h2 id="proof-heading" class="font-poppins">{content.proof.title}</h2>
          <p>{content.proof.description}</p>
        </div>
        <figure class="proof-figure">
          <div class:list={['proof-images', { paired: content.proof.images.length > 1 }]}>
            {content.proof.images.map((image) => (
              <a class="proof-image" href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`${image.alt}. ${common.enlarge}`}><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>
            ))}
          </div>
          <figcaption>{content.proof.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="connection business-section" aria-labelledby="connection-heading">
      <div class="business-shell connection-grid">
        <div>
          <p class="eyebrow">{common.platform}</p>
          <h2 id="connection-heading" class="font-poppins">{content.connection.title}</h2>
          <p class="connection-description">{content.connection.description}</p>
        </div>
        <div class="connection-links">
          {content.connection.links.map((link) => <a href={localePath(link.path, locale)}>{link.label}<span aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </section>

    <section class="diagnostic business-section" aria-labelledby="diagnostic-heading">
      <div class="business-shell diagnostic-inner">
        <span class="diagnostic-leaf" aria-hidden="true">✳</span>
        <h2 id="diagnostic-heading" class="font-poppins">{content.cta.title}</h2>
        <p>{content.cta.description}</p>
        <a class="business-button light" href={diagnosticUrl}>{common.diagnose}<span aria-hidden="true">↗</span></a>
        <small>{common.availability}</small>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .business-area-page { --forest: #123e30; --forest-deep: #083d2e; --ink: #1c332a; --body: #5e6d64; color: var(--ink); }
  .business-shell { width: min(1160px, calc(100% - 40px)); margin-inline: auto; }
  .business-section { padding-block: 72px; }
  .business-hero { position: relative; overflow: hidden; padding-top: 132px; background: #f4f8f5; }
  .hero-leaves { position: absolute; top: 35px; right: -110px; width: 340px; height: 490px; color: #90b9a2; opacity: .2; pointer-events: none; }
  .hero-grid { position: relative; display: grid; align-items: center; gap: 42px; }
  .hero-copy { max-width: 650px; }
  .eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 23px; color: #33775c; font-size: 11px; line-height: 1.6; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; }
  .eyebrow > span { width: 6px; height: 6px; border-radius: 50%; background: #20b2aa; }
  h1 { font-size: clamp(2.25rem, 4.5vw, 3.6rem); font-weight: 700; line-height: 1.14; letter-spacing: -.052em; margin: 0; text-wrap: balance; }
  h1 > span { color: #19846a; }
  .hero-intro { color: #53685c; font-size: 16px; line-height: 1.8; max-width: 550px; margin-top: 25px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 25px; margin-top: 30px; }
  .business-button { display: inline-flex; align-items: center; justify-content: center; gap: 20px; min-height: 50px; padding: 13px 22px; border-radius: 12px; font-size: 13px; font-weight: 600; text-align: center; transition: background .2s ease, box-shadow .2s ease; }
  .business-button.primary { background: var(--forest-deep); color: #fff; }
  .business-button.primary:hover { background: #126048; box-shadow: 0 5px 18px #0d4d3320; }
  .business-button span { font-size: 19px; line-height: 1; }
  .text-link { display: inline-flex; align-items: center; gap: 15px; min-height: 44px; color: #285d47; font-size: 13px; font-weight: 500; }
  .text-link:hover { color: #12735b; }
  a:focus-visible { outline: 3px solid #20b2aa; outline-offset: 5px; }
  .promise-row { display: flex; align-items: flex-start; gap: 13px; padding-block: 28px; border-top: 1px solid #dce8de; margin-top: 46px; }
  .promise-row span { color: #22866b; font-size: 20px; }
  .promise-row p { color: #536a5c; font-size: 12px; line-height: 1.8; padding-top: 3px; }
  .section-intro { max-width: 670px; }
  h2 { font-size: clamp(1.75rem, 3vw, 2.55rem); line-height: 1.25; font-weight: 700; letter-spacing: -.04em; text-wrap: balance; }
  .section-intro > p, .proof-intro > p:not(.eyebrow), .connection-description { color: var(--body); font-size: 15px; line-height: 1.85; margin-top: 20px; }
  .capability-grid { display: grid; gap: 0 48px; margin-top: 39px; }
  .capability { border-top: 1px solid #dce5de; padding: 27px 0; }
  .capability-number { display: block; color: #36856a; font-size: 11px; letter-spacing: .1em; font-weight: 600; margin-bottom: 17px; }
  h3 { font-size: 18px; line-height: 1.4; font-weight: 700; letter-spacing: -.025em; margin-bottom: 12px; }
  .capability > p { color: var(--body); font-size: 14px; line-height: 1.8; max-width: 470px; }
  .capability-detail { display: block; margin-top: 22px; color: #47705a; font-size: 10px; line-height: 1.8; font-weight: 500; }
  .product-proof { background: #f7f8f4; }
  .proof-intro { max-width: 680px; margin-bottom: 37px; }
  .proof-intro .eyebrow { margin-bottom: 18px; }
  .proof-figure { margin: 0; }
  .proof-images { display: grid; gap: 20px; }
  .proof-image { display: block; min-width: 0; overflow: hidden; background: #fff; border: 1px solid #e1e5de; border-radius: 14px; padding: 6px; box-shadow: 0 12px 38px -28px #223d2d65; }
  .proof-image img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .proof-figure figcaption { color: #6d776e; font-size: 10px; line-height: 1.8; margin-top: 19px; max-width: 680px; }
  .connection-grid { display: grid; gap: 30px; }
  .connection-grid h2 { max-width: 580px; }
  .connection .eyebrow { margin-bottom: 17px; }
  .connection-description { max-width: 560px; }
  .connection-links { display: flex; flex-direction: column; justify-content: center; }
  .connection-links a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 64px; padding: 17px 0; border-bottom: 1px solid #dce6de; font-size: 15px; color: #305e46; font-weight: 500; transition: color .2s ease; }
  .connection-links a:first-child { border-top: 1px solid #dce6de; }
  .connection-links a:hover { color: #0c8c6b; }
  .connection-links span { font-size: 23px; color: #397b5f; }
  .diagnostic { background: linear-gradient(125deg, #073d2c, #0e4d3d 70%, #125d4d); text-align: center; color: #fff; }
  .diagnostic-inner { max-width: 740px; }
  .diagnostic-leaf { display: block; color: #6fc2a7; font-size: 35px; margin-bottom: 23px; }
  .diagnostic h2 { color: #f5fff8; }
  .diagnostic p { max-width: 570px; margin: 23px auto 29px; font-size: 15px; line-height: 1.8; color: #cfdfd2; }
  .business-button.light { background: #f4f9f0; color: #0d4734; }
  .business-button.light:hover { background: #dcf5de; }
  .diagnostic small { display: block; color: #b4cebc; font-size: 10px; line-height: 1.8; margin: 24px auto 0; max-width: 500px; }
  @media (min-width: 640px) {
    .business-shell { width: min(1160px, calc(100% - 64px)); }
    .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .capability { padding-block: 32px; }
    .promise-row p { font-size: 13px; }
  }
  @media (min-width: 1024px) {
    .business-section { padding-block: 100px; }
    .business-hero { padding-top: 155px; }
    .hero-grid { grid-template-columns: 1.14fr 1fr; gap: 55px; }
    .hero-visual { margin-top: -15px; }
    .hero-intro { font-size: 17px; }
    .hero-actions { margin-top: 34px; }
    .promise-row { margin-top: 63px; padding-block: 30px; }
    .capability-grid { margin-top: 55px; gap: 0 90px; }
    .proof-intro { max-width: 760px; margin-bottom: 45px; }
    .proof-images.paired { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
    .proof-image { padding: 9px; border-radius: 18px; }
    .connection-grid { grid-template-columns: 1.3fr 1fr; gap: 100px; }
    .diagnostic-inner { max-width: 740px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .business-area-page a { transition: none; }
  }
</style>
