const ui = {
  'pt-BR': {sourceNote:'Telas reais de diferentes operações e períodos.',gallery:'Ampliar as capturas reais',open:'Ampliar captura'},
  'en-US': {sourceNote:'Real screens from different operations and periods.',gallery:'Enlarge the real screenshots',open:'Enlarge screenshot'},
  'es-ES': {sourceNote:'Pantallas reales de diferentes operaciones y períodos.',gallery:'Ampliar las capturas reales',open:'Ampliar captura'},
}[locale];
const routineUI = {
  'pt-BR': {demo:'Produto · demonstração',sourceNote:'Telas reais e interfaces do produto reproduzidas para demonstração. Atividades e campos ilustrativos.'},
  'en-US': {demo:'Product demo · UI in Portuguese',sourceNote:'Real screens and product interfaces reproduced for demonstration. Illustrative activities and fields.'},
  'es-ES': {demo:'Producto · demostración · interfaz en portugués',sourceNote:'Pantallas reales e interfaces del producto reproducidas para demostración. Actividades y campos ilustrativos.'},
}[locale];
const connectionUI = {
  'pt-BR': {demo:'Produto · demonstração',sourceNote:'Telas reais e interface do produto reproduzida para demonstração. Exemplo de conexão com uma API existente.'},
  'en-US': {demo:'Product demo · UI in Portuguese',sourceNote:'Real screens and a product interface reproduced for demonstration. Example connection to an existing API.'},
  'es-ES': {demo:'Producto · demostración · interfaz en portugués',sourceNote:'Pantallas reales e interfaz del producto reproducida para demostración. Ejemplo de conexión con una API existente.'},
}[locale];
const scenes = scenesByKind[kind];
const scenario = copies[locale][kind];
const illustratedUI = kind === 'automacoes' ? routineUI : kind === 'sistemas' ? connectionUI : null;
const copy: JourneyCopy = {...controls,...(illustratedUI ? {demo:illustratedUI.demo} : {}),title:scenario.title,label:scenario.label,chapters:scenario.chapters,captions:scenario.captions};
const screenKey = (scene: Scene) => `operations-${kind}-${scene.key}`;
const frames: JourneyFrame[] = scenes.flatMap((scene,chapter) => [
  {screen:screenKey(scene),focus:`${screenKey(scene)}-overview`,zoom:scene.routine === 'activity' ? 1.35 : 1,duration:1000,chapter},
  {screen:screenKey(scene),focus:`${screenKey(scene)}-detail`,zoom:scene.zoom ?? 2.1,duration:5600,chapter,...(scene.routine === 'activity' ? {state:'activity-builder'} : scene.routine === 'connection' ? {state:'connection-builder'} : {})},
]);
const gallerySources = [...new Set(scenes.flatMap(scene => scene.source ? [scene.source] : []))];
---
<div class="operations-scenario-journey" data-operations-scenario-journey={kind}>
  <ProductJourney locale={locale} variant="operations" copy={copy} frames={frames} chapterFrames={[1,3,5]} staticLabels={scenario.chapters} staticValues={scenario.staticValues} sourceNote={illustratedUI?.sourceNote ?? ui.sourceNote}>
    {scenes.map(scene => {
      const source = scene.source ? sources[scene.source] : null;
      return <div class="osc-screen" data-j-screen={screenKey(scene)}>
        {source && <img class:list={['osc-capture',{'osc-capture--activity':scene.routine === 'activity','osc-capture--connection':scene.routine === 'connection'}]} src={source.src} width={source.width} height={source.height} alt="" loading="lazy" decoding="async" data-operations-source={source.src} style={`width:${scene.imageWidth}px;left:${scene.left}px;top:${scene.top}px`}/>}
        {scene.routine && <div class:list={['osc-routine',{'osc-routine--activity':scene.routine === 'activity','osc-routine--connection':scene.routine === 'connection'}]}>{scene.routine === 'connection' ? <OperationsConnectionBuildScreen/> : <OperationsRoutineScreens kind={scene.routine}/>}</div>}
        <span class="osc-target" data-j-target={`${screenKey(scene)}-overview`} style="left:560px;top:350px"></span>
        <span class="osc-target" data-j-target={`${screenKey(scene)}-detail`} style={`left:${scene.x}px;top:${scene.y}px`}></span>
      </div>;
    })}
  </ProductJourney>
  <nav class="osc-sources" aria-label={ui.gallery}>
    {gallerySources.map(key => <a href={sources[key].src} data-marketing-image data-image-title={sourceLabels[locale][key]} data-image-alt={sourceAlts[locale][key]} data-operations-source={sources[key].src} target="_blank" rel="noopener noreferrer" aria-label={`${ui.open}: ${sourceLabels[locale][key]}`}>{sourceLabels[locale][key]}<span aria-hidden="true"><UIIcon name="arrow-up-right" /></span></a>)}
  </nav>
</div>

<style>
  .operations-scenario-journey{min-width:0;padding:0 clamp(14px,3vw,24px) 22px}
  .osc-screen{position:absolute;inset:0;width:1120px;height:700px;overflow:hidden;background:#f7f9f9;visibility:hidden;opacity:0}
  .osc-screen.is-active{visibility:visible;opacity:1}
  .osc-capture{position:absolute;display:block;height:auto;max-width:none;border:0;border-radius:0}
  .osc-routine{position:absolute;inset:0}.osc-routine--activity,.osc-routine--connection{display:none}
  .operations-scenario-journey :global(.marketing-journey[data-state=activity-builder]) .osc-routine--activity{display:block}
  .operations-scenario-journey :global(.marketing-journey[data-state=activity-builder]) .osc-capture--activity{visibility:hidden}
  .operations-scenario-journey :global(.marketing-journey[data-state=connection-builder]) .osc-routine--connection{display:block}
  .operations-scenario-journey :global(.marketing-journey[data-state=connection-builder]) .osc-capture--connection{visibility:hidden}
  .osc-target{position:absolute;width:1px;height:1px;pointer-events:none}
  .operations-scenario-journey :global(.mj-heading){flex-wrap:wrap;row-gap:6px}
  .operations-scenario-journey :global(.marketing-journey[data-journey=operations] .mj-chapters){grid-template-columns:repeat(3,minmax(0,1fr))}
  .operations-scenario-journey :global(.marketing-journey[data-journey=operations] .mj-chapters button){grid-column:auto!important;min-height:44px;padding:8px 3px;overflow-wrap:anywhere}
  .operations-scenario-journey :global(.mj-static>div){grid-template-columns:repeat(3,minmax(0,1fr))}
  .operations-scenario-journey :global(.mj-caption){min-height:60px}
  .operations-scenario-journey :global(.mj-controls button){min-height:44px}
  .operations-scenario-journey :global(.mj-controls .mj-icon-button){min-width:44px}
  .operations-scenario-journey :global(.mj-source-note){font-size:10px;line-height:1.6}
  .osc-sources{display:flex;align-items:center;flex-wrap:wrap;gap:0 14px;margin-top:4px}
  .osc-sources a{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;min-width:44px;font:500 10px/1.5 Inter,sans-serif;color:#35684f;text-decoration:underline;text-underline-offset:3px}
  .osc-sources a:hover{color:#173f31}
  .osc-sources a:focus-visible{outline:2px solid #20b2aa;outline-offset:3px;border-radius:4px}
  @media(max-width:600px){.operations-scenario-journey :global(.mj-controls){gap:4px}.operations-scenario-journey :global(.mj-controls button){padding-inline:5px}.operations-scenario-journey :global(.mj-chapters button){font-size:9px}.operations-scenario-journey :global(.mj-caption){min-height:80px}.osc-sources{gap:0 12px}}
</style>
