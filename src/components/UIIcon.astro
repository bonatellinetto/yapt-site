---
type IconName = 'arrow-up-right' | 'arrow-down' | 'arrow-right' | 'arrow-left' | 'check' | 'close' | 'plus' | 'sparkle' | 'play' | 'pause' | 'circle';
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 18, class: className } = Astro.props;
const paths: Record<IconName, string> = {
  'arrow-up-right': 'M6 18 18 6M6 6h12v12',
  'arrow-down': 'M12 4v16m-7-7 7 7 7-7',
  'arrow-right': 'M4 12h16m-7-7 7 7-7 7',
  'arrow-left': 'M20 12H4m7-7-7 7 7 7',
  check: 'm5 12 4 4L19 6',
  close: 'm6 6 12 12M18 6 6 18',
  plus: 'M12 5v14M5 12h14',
  sparkle: 'm12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z',
  play: 'm8 5 11 7-11 7V5Z',
  pause: 'M9 5v14M15 5v14',
  circle: 'M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-4 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
};
---
<svg class:list={['ui-icon', className]} data-ui-icon={name} xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill={name === 'play' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
<style>.ui-icon{display:inline-block;flex-shrink:0;vertical-align:middle;pointer-events:none}</style>
