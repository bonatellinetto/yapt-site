---
import { localePath, type Locale } from '../lib/i18n';
import { navigationCopy, type NavigationGroup } from '../lib/navigation';

interface Props { locale: Locale; }
interface FooterCopy {
  navigation: string;
  description: string;
  solutions: string;
  platform: string;
  together: string;
  team: string;
  trust: string;
  diagnosis: string;
  terms: string;
  privacy: string;
  rights: string;
}

const dictionary: Record<Locale, FooterCopy> = {
  'pt-BR': {
    navigation: 'Navegação do rodapé',
    description: 'Inteligência artificial, automações e pessoas na mesma operação.',
    solutions: 'Soluções', platform: 'Plataforma', together: 'Com você',
    team: 'Quem faz', trust: 'Confiança', diagnosis: 'Diagnóstico',
    terms: 'Termos de uso', privacy: 'Privacidade', rights: 'Todos os direitos reservados.',
  },
  'en-US': {
    navigation: 'Footer navigation',
    description: 'Artificial intelligence, automations and people in one operation.',
    solutions: 'Solutions', platform: 'Platform', together: 'With you',
    team: 'Our people', trust: 'Trust', diagnosis: 'Diagnosis',
    terms: 'Terms of use', privacy: 'Privacy', rights: 'All rights reserved.',
  },
  'es-ES': {
    navigation: 'Navegación del pie de página',
    description: 'Inteligencia artificial, automatizaciones y personas en la misma operación.',
    solutions: 'Soluciones', platform: 'Plataforma', together: 'Contigo',
    team: 'Quién lo hace', trust: 'Confianza', diagnosis: 'Diagnóstico',
    terms: 'Términos de uso', privacy: 'Privacidad', rights: 'Todos los derechos reservados.',
  },
};

const { locale } = Astro.props;
const copy = dictionary[locale];
const navigation = navigationCopy[locale];
const groups: NavigationGroup[] = [
  { label: copy.solutions, links: [
    ...navigation.primary.filter(link => link.href !== '/'),
    ...navigation.groups[0].links.filter(link => link.href !== '/#time' && link.href !== '/teams'),
  ] },
  { label: copy.platform, links: [
    ...navigation.groups[1].links,
    ...navigation.groups[0].links.filter(link => link.href === '/teams'),
  ] },
  { label: copy.together, links: [
    { label: copy.team, href: '/#time' },
    { label: navigation.insights, href: '/blog' },
    { label: copy.trust, href: '/trust' },
    { label: copy.diagnosis, href: '/#diagnostico' },
  ] },
];
import { whatsappHref } from '../lib/whatsapp';
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav class="footer-grid" aria-label={copy.navigation}>
      <div class="footer-brand">
        <a class="footer-logo" href={localePath('/', locale)} aria-label={navigation.home}>
          <img src="/yapt-logo-dark.svg" alt="yapt." width="112" height="40" loading="lazy" />
        </a>
        <p>{copy.description}</p>
      </div>
      {groups.map(group => (
        <div class="footer-group">
          <h2>{group.label}</h2>
          <ul>
            {group.links.map(link => <li><a href={link.href === '/#diagnostico' ? whatsappHref : localePath(link.href, locale)} target={link.href === '/#diagnostico' ? '_blank' : undefined} rel={link.href === '/#diagnostico' ? 'noopener noreferrer' : undefined} data-diagnostic-trigger={link.href === '/#diagnostico' ? '' : undefined} data-diagnostic-placement={link.href === '/#diagnostico' ? 'footer' : undefined}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} yapt. {copy.rights}</p>
      <div class="footer-legal">
        <a href={localePath('/terms', locale)}>{copy.terms}</a>
        <a href={localePath('/privacy', locale)}>{copy.privacy}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { position:relative; overflow:hidden; padding:64px 24px 20px; background:#092c25; color:#f4f9f5; font-family:Poppins,sans-serif; }
  .site-footer::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,#20b2aa65,transparent); }
  .footer-inner { position:relative; max-width:1240px; margin:auto; }
  .footer-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px 22px; }
  .footer-brand { padding-right:2px; }
  .footer-logo { display:inline-flex; align-items:center; min-width:112px; min-height:44px; border-radius:8px; }
  .footer-logo img { display:block; width:112px; height:auto; }
  .footer-brand p { max-width:250px; margin:18px 0 0; color:#bdd0c6; font-family:Inter,sans-serif; font-size:13px; line-height:1.8; }
  .footer-group h2 { margin:10px 0 14px; color:#fff; font-size:12px; font-weight:600; letter-spacing:.02em; }
  .footer-group ul { list-style:none; padding:0; margin:0; }
  .footer-group li { margin:0; }
  .footer-group a { display:flex; align-items:center; min-height:44px; padding:8px 0; color:#bdd0c6; font-size:12px; line-height:1.5; text-decoration:none; transition:color .18s; }
  .site-footer a:hover { color:#2dd4bf; }
  .site-footer a:focus-visible { outline:2px solid #2dd4bf; outline-offset:4px; border-radius:4px; }
  .footer-bottom { display:flex; flex-direction:column; gap:10px; margin-top:42px; padding-top:20px; border-top:1px solid #ffffff1a; }
  .footer-bottom p { margin:0; color:#9bb5a8; font-family:Inter,sans-serif; font-size:11px; line-height:1.8; }
  .footer-legal { display:flex; flex-wrap:wrap; gap:12px 26px; }
  .footer-legal a { display:flex; align-items:center; min-width:44px; min-height:44px; color:#bdd0c6; font-size:11px; text-decoration:none; transition:color .18s; }
  @media (min-width:768px) {
    .site-footer { padding:72px 32px 24px; }
    .footer-grid { grid-template-columns:1.3fr 1fr 1fr 1fr; gap:40px; }
    .footer-bottom { flex-direction:row; align-items:center; justify-content:space-between; margin-top:58px; padding-top:20px; }
  }
  @media (prefers-reduced-motion:reduce) { .site-footer a { transition:none; } }
</style>
