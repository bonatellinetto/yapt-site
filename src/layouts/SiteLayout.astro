---
import '../styles/global.css';
import SiteNavbar from '../components/SiteNavbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DiagnosticRecovery from '../components/diagnostic/DiagnosticRecovery.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import { localeHtmlLang } from '../lib/i18n';
import type { SEOProps } from '../lib/seo';
import SiteSEO from '../components/SiteSEO.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

export interface Props extends SEOProps { noHreflang?: boolean; minimalNav?: boolean }
const { locale, minimalNav = false } = Astro.props;
const htmlLang = localeHtmlLang[locale];
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <SiteSEO {...Astro.props} />
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Fonts: Inter + Poppins — preloaded to avoid render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
  </noscript>

</head>
<body class="min-h-screen bg-white">
  <SiteAnalytics />
  <SiteNavbar locale={locale} minimal={minimalNav} />
  <slot />
  <SiteFooter locale={locale} />
  <DiagnosticRecovery locale={locale} />

  <!-- Scroll-triggered fade-in observer -->
  <script is:inline>
    (function() {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var targets = entry.target.querySelectorAll('[data-fade]');
            if (targets.length === 0 && entry.target.hasAttribute('data-fade')) {
              targets = [entry.target];
            }
            targets.forEach(function(el, i) {
              setTimeout(function() {
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
              }, i * 120);
            });
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('[data-observe]').forEach(function(el) {
        observer.observe(el);
      });
      document.querySelectorAll('[data-fade]').forEach(function(el) {
        if (!el.closest('[data-observe]')) {
          observer.observe(el);
        }
      });
    })();
  </script>

  <WhatsAppWidget />
  <script>import '../scripts/diagnostic';</script>
</body>
</html>
