  }

  /* ─── MOBILE ─── */
  @media (max-width: 900px) {
    .hero-grid, .video-dobra, .split, .split.esq, .split.conn-slide, .conn-slide { grid-template-columns: 1fr !important; gap: 26px; }
    /* nas dobras com print à esquerda, no mobile o texto vem primeiro */
