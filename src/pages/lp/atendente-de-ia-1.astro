  .ia-kpi.destaque .v { color: var(--teal); }

  .ia-exp { display: flex; justify-content: flex-end; margin-top: 14px; }
  .ia-exp span { display: inline-flex; align-items: center; gap: 8px; border: 1px solid #E5E9EC; border-radius: 9px; padding: 8px 13px; font-size: 13.5px; color: #434A54; }
  .ia-exp span .i { color: #9AA5AC; display: flex; }

  .ia-tab { border: 1px solid #E5E9EC; border-radius: 13px; margin-top: 12px; overflow: hidden; }
  .ia-tab .r { display: grid; grid-template-columns: 1fr 130px 150px 130px 150px 130px; align-items: center; padding: 13px 22px; font-size: 13.5px; }
  .ia-tab .r > *:not(:first-child) { text-align: right; }
  .ia-tab .r.h { color: #6B7680; border-bottom: 1px solid #EEF1F3; }
  .ia-tab .r.d { color: #1F2937; border-bottom: 1px solid #F4F6F7; }
  .ia-tab .r.d:last-child { border-bottom: 0; }
  .ia-tab .r.d .dt { color: #434A54; }
  .ia-tab .r.d .ct { color: #17A398; font-weight: 600; }

  /* ─── TABELA DE DOIS LADOS (frente 1) ───
     Serve duas dobras: "antes e depois" e "chatbot × agente de IA". Uma peça
     só nas duas de propósito — é o mesmo gesto de leitura, e duas tabelas
     diferentes na mesma página leriam como dois sistemas. */
  .ad { border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: #fff; box-shadow: 0 1px 2px rgba(15,15,15,0.04); }
  .ad-h, .ad-r { display: grid; grid-template-columns: 1fr 1fr; }
  .ad-h { background: #F7F9FA; }
  .ad-h span { padding: 14px 24px; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: .07em; text-transform: uppercase; }
  .ad-h span:first-child { color: #9AA5AC; }
  .ad-h span:last-child { color: var(--teal); }
  .ad-r { border-top: 1px solid #EEF1F3; }
  /* listrado: o cabeçalho é o 1º filho, então par pega a 1ª e a 3ª linha */
  .ad-r:nth-child(even) { background: #FCFDFE; }
  .ad-r span { padding: 18px 24px; font-size: 15px; line-height: 1.5; }
  .ad-r .a { color: #8A96A0; border-right: 1px solid #EEF1F3; }
  .ad-r .d { color: var(--feature-text); }
  .ad-nota { font-size: 14px; color: #9AA5AC; margin-top: 16px; text-align: center; }

  /* ─── POR RAMO (frente 1) ─── */
  .ramo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .ramo-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 20px; }
  .ramo-card .ic { width: 36px; height: 36px; border-radius: 11px; background: #E9F7F6; color: var(--teal); display: flex; align-items: center; justify-content: center; margin-bottom: 13px; }
  .ramo-card b { display: block; font-family: 'Poppins', sans-serif; font-size: 15px; color: var(--slate); margin-bottom: 6px; }
  .ramo-card span { font-size: 14px; color: var(--feature-text); }

  /* ─── DOIS PLANOS (frente 1) ─── */
  .planos-grid.dois { grid-template-columns: repeat(2, 1fr); max-width: 740px; margin-left: auto; margin-right: auto; }
  .timeline.tres { grid-template-columns: repeat(3, 1fr); }

  /* ─── A CONTA DOS DOIS LADOS (frente 3) ─── */
  .conta-cenario { display: inline-flex; align-items: center; gap: 9px; background: #F1F4F6; border-radius: 100px; padding: 8px 16px; font-size: 13px; color: #6B7680; margin-bottom: 24px; }
  .conta-cenario .ic { color: #9AA5AC; display: flex; }
  .conta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .conta-card { border: 1px solid var(--border); border-radius: 20px; background: #fff; padding: 26px; display: flex; flex-direction: column; }
  .conta-card.nosso { border-color: rgba(32,178,170,.45); background: linear-gradient(180deg, #F4FCFB 0%, #FFFFFF 100%); }
  .conta-card .rot { font-family: 'Poppins', sans-serif; font-size: 11.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #9AA5AC; margin-bottom: 12px; }
  .conta-card.nosso .rot { color: var(--teal); }
  .conta-card .tot { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 34px; color: var(--slate); line-height: 1.1; letter-spacing: -.02em; }
  .conta-card.nosso .tot { color: var(--teal); }
  .conta-card .tot span { font-size: 14px; font-weight: 500; color: #7A8691; }
  .conta-card ul { list-style: none; margin-top: 18px; font-size: 14.5px; color: var(--feature-text); }
  .conta-card li { padding: 9px 0; border-top: 1px solid #EEF1F3; display: flex; gap: 10px; }
  .conta-card li .k { color: #9AA5AC; font-size: 13px; flex-shrink: 0; width: 104px; }
  .conta-fecho { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; margin-top: 26px; padding: 26px 32px; border-radius: 20px; background: linear-gradient(135deg, #064E3B 0%, #0D9488 55%, #20B2AA 100%); box-shadow: 0 2px 4px rgba(32,178,170,0.10), 0 16px 40px rgba(32,178,170,0.20); }
  .conta-fecho .num { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 46px; line-height: 1; letter-spacing: -.02em; color: #fff; white-space: nowrap; }
  .conta-fecho .txt { font-size: 16px; line-height: 1.5; color: rgba(255,255,255,0.9); }
  .conta-fecho .txt b { color: #fff; font-weight: 600; }

  /* ─── TABELA DE SIM E NÃO (frente 3) ─── */
  .cmp { border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: #fff; }
  .cmp .r { display: grid; grid-template-columns: 30px 1fr 1fr; align-items: start; gap: 18px; padding: 15px 22px; font-size: 14.5px; border-top: 1px solid #F1F4F6; }
  .cmp .r:first-child { border-top: 0; }
  .cmp .r.h { background: #F7F9FA; font-family: 'Poppins', sans-serif; font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #7A8691; }
  .cmp .r .n { color: #C3CDD3; font-size: 13px; }
  .cmp .r .nosso { color: var(--slate); display: flex; gap: 10px; }
  .cmp .r .nosso::before { content: '✓'; color: var(--teal); font-weight: 700; flex-shrink: 0; }
  .cmp .r .deles { color: #8A96A0; }
  .cmp-fonte { font-size: 12px; color: #9AA5AC; margin-top: 16px; max-width: 800px; line-height: 1.6; }

  /* ─── PENDÊNCIA EDITORIAL (aparece na revisão interna, some quando resolver) ─── */
  .bloqueio { border: 2px dashed #E0A94B; background: #FFFBF2; border-radius: 14px; padding: 17px 19px; font-size: 13.5px; color: #8A6A22; margin-top: 20px; line-height: 1.55; }
  .bloqueio > b:first-child { display: block; font-family: 'Poppins', sans-serif; font-size: 13px; margin-bottom: 5px; color: #7A5A12; letter-spacing: .02em; }
  .bloqueio b { color: #7A5A12; }

  @media (max-width: 900px) {
    .conta-grid { grid-template-columns: 1fr !important; }
    .ramo-grid { grid-template-columns: 1fr 1fr; }
