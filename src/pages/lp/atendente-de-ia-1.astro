    /* carrossel: setas maiores pro dedo, bolinhas mais visíveis */
    .car-arrow { width: 40px; height: 40px; font-size: 18px; }
    .car-nav { gap: 18px; margin-top: 14px; }
    .car-dots b { width: 8px; height: 8px; }
    .car-dots b.on { width: 22px; }
    .car-step .t { font-size: 18px; }

    /* cards de dor e de suporte mais compactos */
    .dor-card { padding: 18px; font-size: 14.5px; }
    .suporte-card { padding: 14px; }
    .suporte-card b { font-size: 13.5px; }
    .suporte-card div { font-size: 12.5px; }

    /* FAQ com alvo de toque maior */
    .faq-q { padding: 17px 0; font-size: 14.5px; }
    .faq-a { font-size: 13.5px; }

    /* planos: preço e o que entra mais apertados */
    .plano-card { padding: 20px; }
    .plano-price { font-size: 24px; }
    .plano-inclui { font-size: 12.5px; }
    .enterprise-band { flex-direction: column; align-items: stretch; padding: 22px; gap: 16px; }
    .enterprise-band .eb-list { gap: 6px 16px; }
    .enterprise-band .btn { width: 100%; }

    footer { font-size: 11px; padding: 24px 0 34px; }
  }

  /* o mockup do inbox é uma tela de 1400px: no mobile ele rola na horizontal
