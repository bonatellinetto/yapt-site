    .video-dobra.reverse .video-col { order: 2; }
    .dor-grid { grid-template-columns: 1fr; }
    .planos-grid { grid-template-columns: 1fr; max-width: 460px; margin-left: auto; margin-right: auto; }
    .timeline { grid-template-columns: 1fr 1fr; }
    .trust-sep { display: none; }
    .container.larga { max-width: 100%; }
  }

  @media (max-width: 600px) {
    section { padding: 40px 0; }
    .container { padding: 0 18px; }
    h2.section-title { font-size: 24px; line-height: 1.25; }
    .hero-headline { font-size: 28px; line-height: 1.2; }
