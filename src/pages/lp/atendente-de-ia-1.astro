    /* seletor de plano e CTA ocupando a largura */
    .plan-selector { padding: 16px; max-width: 100%; }

    /* badge de parceria: compacto, numa linha só */
    .partner-badge { gap: 8px; padding: 5px 10px; margin-bottom: 20px; flex-wrap: nowrap; }
