  .conta-card .tot span { font-size: 14px; font-weight: 500; color: #7A8691; }
  .conta-card ul { list-style: none; margin-top: 18px; font-size: 14.5px; color: var(--feature-text); }
  .conta-card li { padding: 9px 0; border-top: 1px solid #EEF1F3; display: flex; gap: 10px; }
  .conta-card li .k { color: #9AA5AC; font-size: 13px; flex-shrink: 0; width: 104px; }
  .conta-fecho { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; margin-top: 26px; padding: 26px 32px; border-radius: 20px; background: linear-gradient(135deg, #064E3B 0%, #0D9488 55%, #20B2AA 100%); box-shadow: 0 2px 4px rgba(32,178,170,0.10), 0 16px 40px rgba(32,178,170,0.20); }
  .conta-fecho .num { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 46px; line-height: 1; letter-spacing: -.02em; color: #fff; white-space: nowrap; }
  .conta-fecho .txt { font-size: 16px; line-height: 1.5; color: rgba(255,255,255,0.9); }
  .conta-fecho .txt b { color: #fff; font-weight: 600; }

  /* ─── TABELA DE SIM E NÃO (frente 3) ─── */
  .cmp { border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: #fff; }
  .cmp .r { display: grid; grid-template-columns: 30px 1fr 1fr; align-items: start; gap: 18px; padding: 15px 22px; font-size: 14.5px; border-top: 1px solid #F1F4F6; }
  .cmp .r:first-child { border-top: 0; }
  .cmp .r.h { background: #F7F9FA; font-family: 'Poppins', sans-serif; font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #7A8691; }
  .cmp .r .n { color: #C3CDD3; font-size: 13px; }
  .cmp .r .nosso { color: var(--slate); display: flex; gap: 10px; }
  .cmp .r .nosso::before { content: '✓'; color: var(--teal); font-weight: 700; flex-shrink: 0; }
  .cmp .r .deles { color: #8A96A0; }
  .cmp-fonte { font-size: 12px; color: #9AA5AC; margin-top: 16px; max-width: 800px; line-height: 1.6; }

  /* ─── PENDÊNCIA EDITORIAL (aparece na revisão interna, some quando resolver) ─── */
  .bloqueio { border: 2px dashed #E0A94B; background: #FFFBF2; border-radius: 14px; padding: 17px 19px; font-size: 13.5px; color: #8A6A22; margin-top: 20px; line-height: 1.55; }
  .bloqueio > b:first-child { display: block; font-family: 'Poppins', sans-serif; font-size: 13px; margin-bottom: 5px; color: #7A5A12; letter-spacing: .02em; }
  .bloqueio b { color: #7A5A12; }

