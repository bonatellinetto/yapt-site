  .conta-card { border: 1px solid var(--border); border-radius: 20px; background: #fff; padding: 26px; display: flex; flex-direction: column; }
  .conta-card.nosso { border-color: rgba(32,178,170,.45); background: linear-gradient(180deg, #F4FCFB 0%, #FFFFFF 100%); }
  .conta-card .rot { font-family: 'Poppins', sans-serif; font-size: 11.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #9AA5AC; margin-bottom: 12px; }
  .conta-card.nosso .rot { color: var(--teal); }
  .conta-card .tot { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 34px; color: var(--slate); line-height: 1.1; letter-spacing: -.02em; }
