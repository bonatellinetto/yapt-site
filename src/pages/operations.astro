---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ModuleDeepDive from '../components/ModuleDeepDive.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SectionDivider from '../components/SectionDivider.astro';
import CTASection from '../components/CTASection.astro';
import ScreenShot from '../components/ScreenShot.astro';
import { t, type Locale } from '../lib/i18n';
import { antColonySvg, genericIcons } from '../lib/fauna';

const locale = 'pt-BR' as const;
const m = (key: string) => t(`operations.${key}`, locale);
const meta = m('meta') as { title: string; description: string };
const hero = m('hero') as { badge: string; title: string; subtitle: string };

const gridData = m('grid') as Record<string, any>;
const gridKeys = Object.keys(gridData).filter(k => k !== 'title' && k !== 'subtitle');
const gridFeatures = gridKeys.map(k => ({
  icon: genericIcons[k as keyof typeof genericIcons] || genericIcons.settings,
  title: gridData[k].title,
  description: gridData[k].description,
}));

const ctaBadges = ['Parceiro Oficial Meta', '40M+ msg/mês', '16 anos'];

const modules = ['inbox','routing','sla','monitor','deals','analytics'] as const;

// Roadmap
const roadmap = m('roadmap') as any;
const roadmapItems = roadmap?.items || [];
---

<SiteLayout title={meta.title} description={meta.description} path="/operations" locale={locale}>
  <PageHero
    gradient="linear-gradient(135deg, #064E3B, #10B981, #34D399)"
    title={hero.title}
    subtitle={hero.subtitle}
    badge={hero.badge}
    fauna={antColonySvg}
  />

  <div class="[&>section]:py-12 [&>section]:lg:py-16">
    {modules.map((key, i) => {
      const mod = m(key) as { subtitle: string; title: string; description: string; features: string[] };
      if (!mod || !mod.title) return null;
      return (
        <>
          <ModuleDeepDive
            title={mod.title}
            subtitle={mod.subtitle}
            description={mod.description}
            features={mod.features || []}
            reversed={i % 2 === 1}
            accentColor="#10B981"
            wide={key !== 'routing'}
          >
            {key === 'inbox' && <ScreenShot src="/produto/ops-filas.webp" alt="Saúde das filas no yapt.: conversas aguardando, com humano, maior espera e operadores disponíveis por setor" width={1600} height={670} />}
            {key === 'routing' && (
              <div class="rounded-2xl overflow-hidden border border-black/[0.06] bg-white shadow-[0_18px_50px_-18px_rgba(26,26,46,0.28)] max-w-md mx-auto">
                <video
                  src="/produto/ops-distribuicao.mp4"
                  poster="/produto/ops-distribuicao.jpg"
                  width="720"
                  height="994"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="none"
                  class="block w-full h-auto"
                  aria-label="Tela de regras de distribuição de um setor no yapt."
                ></video>
              </div>
            )}
            {key === 'sla' && <ScreenShot src="/produto/ops-prazos.webp" alt="Metas de tempo de um setor no yapt.: primeira resposta, próxima resposta, resposta humana e resolução" width={1600} height={1291} />}
            {key === 'monitor' && <ScreenShot src="/produto/ops-equipe.webp" alt="Carga dos operadores no yapt., com conversas atuais contra o limite de cada um" width={1600} height={1057} />}
            {key === 'deals' && (
              <>
                <ScreenShot src="/produto/ops-conversas.webp" alt="Central de conversas do yapt. com vistas por operação e pipelines de conversas" width={1600} height={896} />
                <ScreenShot src="/produto/vendas-funil.webp" alt="Funil de negócios do yapt. com valor por etapa, previsão e meta do mês" width={1600} height={301} />
              </>
            )}
            {key === 'analytics' && (
              <>
                <ScreenShot src="/produto/ops-indicadores-atendimento.webp" alt="Indicadores de atendimento no yapt.: conversas, resolvidas, fila, primeira resposta e volume por dia" width={1600} height={513} />
                <ScreenShot src="/produto/ops-indicadores-suporte.webp" alt="Indicadores de suporte no yapt.: tempo de resposta humano, resolução no primeiro contato e volume diário" width={1600} height={692} />
              </>
            )}
          </ModuleDeepDive>
          {i < modules.length - 1 && <SectionDivider variant="light" />}
        </>
      );
    })}
  </div>

  <FeatureGrid
    title={gridData.title}
    subtitle={gridData.subtitle}
    features={gridFeatures}
    columns={3}
    accentColor="#10B981"
  />

  {/* Roadmap */}
  {roadmapItems.length > 0 && (
    <section data-observe class="py-16 lg:py-24" style="background: linear-gradient(135deg, #1a1a2e, #064E3B);">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
          {roadmap.title && <h2 class="font-poppins text-2xl lg:text-3xl font-bold text-white">{roadmap.title}</h2>}
          {roadmap.subtitle && <p class="text-base text-white/60 mt-4">{roadmap.subtitle}</p>}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {roadmapItems.map((item: any) => (
            <div
              data-fade
              style="opacity:0;transform:translateY(20px);transition:opacity 0.5s ease,transform 0.5s ease;"
              class="bg-white/5 backdrop-blur-sm rounded-2xl p-5 border border-white/10"
            >
              <h3 class="font-poppins text-sm font-semibold text-white mb-1">{item.title}</h3>
              <p class="text-xs text-white/50 leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection locale={locale} badges={ctaBadges} />
</SiteLayout>
