    function reset(){ms.forEach(function(m){m.classList.remove('on')});dig.className='dig';box.classList.remove('some')}
    function step(i){
      if(!run)return;
      if(i>=ms.length){t=setTimeout(function(){box.classList.add('some');t=setTimeout(function(){reset();step(0)},600)},5000);return}
      var m=ms[i],out=m.classList.contains('out');
